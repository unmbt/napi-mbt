{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "napi-mbt configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "napiVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 4
    },
    "builder": {
      "enum": [
        "auto",
        "cmake",
        "gcc",
        "clang",
        "msvc"
      ],
      "default": "auto"
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "win32-x64-msvc",
          "darwin-x64",
          "darwin-arm64",
          "linux-x64-gnu",
          "linux-arm64-gnu"
        ]
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "promise",
          "threadsafe_function",
          "bigint",
          "buffer",
          "class",
          "callback"
        ]
      }
    },
    "cjs": {
      "type": "boolean",
      "default": true
    },
    "esm": {
      "type": "boolean",
      "default": true
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "constructor"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "constructor": {
            "type": "string",
            "minLength": 1
          },
          "methods": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "staticMethods": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "get": {
                  "type": "string",
                  "minLength": 1
                },
                "set": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": [
                    "get"
                  ]
                },
                {
                  "required": [
                    "set"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "not": {
    "required": [
      "cjs",
      "esm"
    ],
    "properties": {
      "cjs": {
        "const": false
      },
      "esm": {
        "const": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "promise"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "threadsafe_function"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 4
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "bigint"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 6
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "buffer"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 7
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "class"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "callback"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "classes"
        ],
        "properties": {
          "classes": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    }
  ]
}
