import {
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "foreign_library")

options(
  "native-stub": [ "stub.c", "napi_glue.c" ],
  link: {
    "native": {
      "cc-flags": "${build.NAPI_C_FLAGS}",
      "stub-cc-flags": "${build.NAPI_C_FLAGS} -I./.napi-mbt/include -DNAPI_VERSION=1",
      "cc-link-flags": "${build.NAPI_LINK_FLAGS}",
      "exports": [
        "moonbit_init",
        "napi_mbt_adapter_add",
        "napi_mbt_adapter_check_bool",
        "napi_mbt_adapter_check_double",
        "napi_mbt_adapter_concat",
        "napi_mbt_adapter_mutate_buffer",
        "napi_mbt_adapter_roundtrip_bytes",
      ],
    },
  },
)
