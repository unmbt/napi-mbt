///|
/// Deterministic MoonBit and C artifact emitters.
pub fn render_moonbit_adapters(exports : Array[ExportSpec]) -> String {
  let mut out = "// Generated by the MoonBit napi-mbt generator.\n"
  exports.each(fn(item) {
    let args = item.parameters
      .mapi(fn(index, _) { "a" + index.to_string() + " : NapiValue" })
      .join(", ")
    out = out +
      "\n///|\n#export_name(\"napi_mbt_adapter_" +
      item.export_name +
      "\")\n"
    out = out + "pub fn napi_mbt_adapter_" + item.export_name + "(env : NapiEnv"
    if !args.is_empty() {
      out = out + ", " + args
    }
    out = out + ") -> NapiValue {\n"
    item.parameters.eachi(fn(index, parameter) {
      out = out +
        "  let p" +
        index.to_string() +
        " = get_" +
        moonbit_type(parameter) +
        "(env, a" +
        index.to_string() +
        ")\n"
    })
    item.parameters.eachi(fn(index, parameter) {
      if moonbit_type(parameter) == "NapiBufferView" {
        out = out + "  p" + index.to_string() + ".invalidate()\n"
      }
    })
    out = out +
      "  set_" +
      item.return_type +
      "(env, " +
      item.source_name +
      "(" +
      item.parameters.mapi(fn(index, _) { "p" + index.to_string() }).join(", ") +
      "))\n}\n"
  })
  out
}

///|
pub fn render_c_glue(exports : Array[ExportSpec], napi_version : Int) -> String {
  let mut out = "/* Generated by the MoonBit napi-mbt generator. */\n#include <node_api.h>\n#include <stddef.h>\nextern void moonbit_init(void);\n"
  exports.each(fn(item) {
    out = out +
      "extern napi_value napi_mbt_adapter_" +
      item.export_name +
      "(napi_env env"
    item.parameters.each(fn(_) { out = out + ", napi_value" })
    out = out + ");\n"
  })
  exports.each(fn(item) {
    let count = item.parameters.length()
    out = out +
      "\nstatic napi_value napi_mbt_callback_" +
      item.export_name +
      "(napi_env env, napi_callback_info info) {\n"
    out = out +
      "  size_t argc = " +
      count.to_string() +
      ";\n  napi_value argv[" +
      (if count > 0 { count } else { 1 }).to_string() +
      "];\n"
    out = out +
      "  if (napi_get_cb_info(env, info, &argc, argv, NULL, NULL) != napi_ok) return NULL;\n"
    out = out +
      "  if (argc < " +
      count.to_string() +
      ") { napi_throw_error(env, NULL, \"Missing argument\"); return NULL; }\n"
    out = out + "  return napi_mbt_adapter_" + item.export_name + "(env"
    for index = 0; index < count; index = index + 1 {
      out = out + ", argv[" + index.to_string() + "]"
    }
    out = out + ");\n}\n"
  })
  out = out + "\nNAPI_MODULE_INIT() {\n  moonbit_init();\n"
  exports.each(fn(item) {
    out = out + "  napi_value fn_" + item.export_name + ";\n"
    out = out +
      "  napi_create_function(env, \"" +
      item.export_name +
      "\", NAPI_AUTO_LENGTH, napi_mbt_callback_" +
      item.export_name +
      ", NULL, &fn_" +
      item.export_name +
      ");\n"
    out = out +
      "  napi_set_named_property(env, exports, \"" +
      item.export_name +
      "\", fn_" +
      item.export_name +
      ");\n"
  })
  out = out +
    "  (void)" +
    napi_version.to_string() +
    ";\n  return exports;\n}\n"
  out
}
