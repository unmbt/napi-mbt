///|
test "async exports infer feature and emit Promise signatures" {
  let source = @generator.parse_source(
    "#export_name(\"wait\")\npub async fn wait(value : Int, options : String?) -> Int { value }",
    "async.mbt",
  )
  assert_true(source.exports[0].is_async)
  assert_true(source.features.contains("async"))
  for
    (name, text) in @generator.render(
      source,
      "async-fixture",
      8,
      package_version="0.1.0",
    ) {
    if name == "index.d.ts" {
      assert_eq(
        text, "// Auto-generated by napi-mbt. DO NOT EDIT.\n/// <reference types=\"node\" />\n\n/**\n * @remarks Node-API errors carry code, status and context; existing JS exceptions preserve identity.\n * @remarks Argument conversion failure prevents business execution.\n * @remarks Business errors use ERR_NAPI_CALL unless they already carry NapiError details.\n * @remarks Failures reject the Promise; cancellation rejects with signal.reason or ABORT_ERR.\n */\nexport function wait(value: number, options?: (string | null | undefined), options_?: { signal?: AbortSignal }): Promise<number>;\n",
      )
    }
  }
  try @generator.render(source, "fixture", 7, package_version="0.1.0") catch {
    _ => ()
  } noraise {
    _ => fail("Async must require N-API 8")
  }
}

///|
test "async rejects borrowed buffers and generic exports with locations" {
  for
    source in [
      "#export_name(\"f\")\npub async fn f(value : NapiBufferView) -> Int { 0 }",
      "#export_name(\"f\")\npub async fn f[T](value : T) -> T { value }",
    ] {
    try @generator.parse_source(source, "invalid-async.mbt") catch {
      error => assert_true(error.to_string().contains("invalid-async.mbt:"))
    } noraise {
      _ => fail("Expected unsupported signature error")
    }
  }
}
