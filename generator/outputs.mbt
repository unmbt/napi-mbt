///|
pub fn ParsedExport::manifest(self : ParsedExport) -> Json {
  let result : Json = {
    "sourceName": self.source_name,
    "exportName": self.export_name,
    "params": self.parameters.map(p => {
      ({ "name": p.name, "type": p.value_type.runtime_name() } : Json)
    }),
    "ret": self.return_type.runtime_name(),
    "throws": self.throws,
    "line": self.line,
    "filename": self.filename,
    "documentation": self.documentation,
    "errors": self.error_contract(),
  }
  if self.is_async && result is Object(fields) {
    fields["async"] = true
  }
  result
}

///|
fn adapters(
  exports : Array[ParsedExport],
  types : Array[TypeDefinition],
  classes : Array[ParsedClass],
  snapshots~ : Array[ParsedExport] = [],
) -> String {
  let out = StringBuilder()
  out.write_string("// Auto-generated by napi-mbt. DO NOT EDIT.\n")
  let readers = conversion_types(exports, types, true)
  let snapshot_values = snapshots
    .map(item => {
      item.parameters.map(p => { ..item, return_type: p.value_type, })
    })
    .flatten()
  let writers = conversion_types(exports + snapshot_values, types, false)
  out.write_string(class_bindings(classes, readers, writers))
  out.write_string(conversions(readers, writers, types, true))
  out.write_string(conversions(writers, readers, types, false))
  for item in exports {
    if item.is_async {
      out.write_string(async_adapter(item, readers, writers))
      continue
    }
    let name = "napi_mbt_adapter_" + item.export_name
    let params = ["env : NapiEnv"]
    if item.binding is ConstructorBinding(_) {
      params.push("receiver : NapiValue")
    }
    let mut js_index = 0
    for p in item.parameters {
      if p.value_type is EnvType {
        continue
      }
      params.push("a\{js_index} : NapiValue")
      js_index += 1
    }
    let line = "pub fn \{name}(\{params.join(", ")}) -> NapiValue {"
    out.write_string("\n///|\n#export_name(\"\{name}\")\n")
    if js_index <= 1 && line.length() <= 80 {
      out.write_string(line + "\n")
    } else {
      out.write_string(
        "pub fn \{name}(\n  \{params.join(",\n  ")},\n) -> NapiValue {\n",
      )
    }
    let arguments = []
    out.write_string("  try {\n")
    let mut js_index = 0
    for i, p in item.parameters {
      let input = if p.value_type is EnvType {
        "env"
      } else {
        let result = "a\{js_index}"
        js_index += 1
        result
      }
      if p.value_type is EnvType {
        // NapiEnv is injected by the callback and is already the MoonBit
        // environment value. It must not go through a NapiValue reader.
        out.write_string("    let p\{i} = env\n")
      } else {
        out.write_string(
          "    let p\{i} = \{conversion_name(p.value_type, readers, true)}(env, \{input}, [])\n",
        )
      }
      arguments.push("p\{i}")
      if p.value_type is BufferViewType {
        out.write_string("    defer p\{i}.invalidate()\n")
      }
    }
    let call = "\{item.source_name}(\{arguments.join(", ")})"
    let result_type = item.return_type.moonbit()
    out.write_string("    let result : \{result_type} = \{call}\n")
    if item.binding is ConstructorBinding(id) {
      out.write_string(
        "    result_from_status(env, napi_mbt_class_wrap_\{id}(env, receiver, result, \{id}), b\"Wrapping native instance\")\n    receiver\n",
      )
    } else {
      out.write_string(
        "    \{conversion_name(item.return_type, writers, false)}(env, result, 0)\n",
      )
    }
    out.write_string(
      "  } catch {\n    error => {\n      throw_napi_error(env, error)\n      moonbit_dummy_napi_value()\n    }\n  }\n}\n",
    )
  }
  out.write_string(worker_snapshot_adapters(snapshots, readers, writers))
  out.to_string()
}

///|
fn c_glue(
  exports : Array[ParsedExport],
  classes : Array[ParsedClass],
  workers~ : Bool = false,
) -> String {
  let out = StringBuilder()
  out.write_string(
    "/* Auto-generated by napi-mbt. DO NOT EDIT. */\n#include <node_api.h>\n#include <stddef.h>\n#include <stdint.h>\n\nextern int napi_mbt_enter(napi_env, void **);\nextern void napi_mbt_leave(void *);\nextern int moonbit_napi_field_set(napi_env, napi_value, const char *, napi_value);\nextern int napi_mbt_throw_status(napi_env, int, int, const char *, const char *);\nstatic napi_value napi_mbt_error(napi_env env, int status, int kind, const char *code, const char *context) {\n  (void)napi_mbt_throw_status(env, status, kind, code, context);\n  return NULL;\n}\nstatic napi_value napi_mbt_registration_error(napi_env env, int status, void *previous, const char *context) {\n  napi_mbt_leave(previous);\n  return napi_mbt_error(env, status, 0, \"ERR_NAPI_REGISTER\", context);\n}\n",
  )
  if workers {
    out.write_string("\n#include \"napi_worker_lifecycle.h\"\n")
  }
  for item in exports {
    out.write_string(
      "extern napi_value napi_mbt_adapter_\{item.export_name}(napi_env env",
    )
    for p in item.parameters {
      if p.value_type is EnvType {
        continue
      }
      out.write_string(", napi_value")
    }
    if item.is_async {
      out.write_string(", napi_value")
    }
    out.write_string(");\n")
  }
  for item in exports {
    let visible_count = item.parameters
      .filter(p => !(p.value_type is EnvType))
      .length()
    let n = visible_count + (if item.is_async { 1 } else { 0 })
    let mut required = 0
    let mut js_index = 0
    for p in item.parameters {
      if p.value_type is EnvType {
        continue
      }
      if !(p.value_type is OptionType(_)) {
        required = js_index + 1
      }
      js_index += 1
    }
    if item.is_async {
      required = 0
    }
    out.write_string(
      "\nstatic napi_value napi_mbt_callback_\{item.export_name}(napi_env env, napi_callback_info info) {\n  size_t argc = \{n};\n  napi_value argv[\{if n > 0 { n } else { 1 }}];\n  napi_status status = napi_get_cb_info(env, info, &argc, argv, NULL, NULL);\n  if (status != napi_ok) return napi_mbt_error(env, status, 0, \"ERR_NAPI_CALLBACK\", \"Reading callback arguments\");\n  if (argc < \{required}) return napi_mbt_error(env, napi_invalid_arg, 1, \"ERR_NAPI_ARGUMENTS\", \"Missing argument\");\n  for (size_t i = argc; i < \{n}; ++i) {\n    status = napi_get_undefined(env, &argv[i]);\n    if (status != napi_ok) return napi_mbt_error(env, status, 0, \"ERR_NAPI_CALLBACK\", \"Filling optional arguments\");\n  }\n",
    )
    out.write_string(
      "  void *previous;\n  int enter_status = napi_mbt_enter(env, &previous);\n  if (enter_status != napi_ok) return napi_mbt_error(env, enter_status, 0, \"ERR_NAPI_ENVIRONMENT\", \"Entering MoonBit environment\");\n  napi_value result = napi_mbt_adapter_\{item.export_name}(env",
    )
    for i in 0..<n {
      out.write_string(", argv[\{i}]")
    }
    out.write_string(");\n  napi_mbt_leave(previous);\n  return result;\n}\n")
  }
  out.write_string(class_callbacks(classes))
  out.write_string(
    "\n#if defined(_WIN32)\n#define NAPI_MBT_EXPORT __declspec(dllexport)\n#else\n#define NAPI_MBT_EXPORT __attribute__((visibility(\"default\")))\n#endif\n\nNAPI_MBT_EXPORT napi_value napi_register_module_v1(napi_env env, napi_value exports) {\n  void *previous;\n  int enter_status = napi_mbt_enter(env, &previous);\n  if (enter_status != napi_ok) return napi_mbt_error(env, enter_status, 0, \"ERR_NAPI_ENVIRONMENT\", \"Initializing MoonBit environment\");\n",
  )
  for item in exports {
    let name = item.export_name
    out.write_string(
      "  napi_value fn_\{name};\n  int status_\{name} = napi_create_function(env, \"\{name}\", NAPI_AUTO_LENGTH, napi_mbt_callback_\{name}, NULL, &fn_\{name});\n  if (status_\{name} != napi_ok) return napi_mbt_registration_error(env, status_\{name}, previous, \"Creating export \{name}\");\n  status_\{name} = moonbit_napi_field_set(env, exports, \"\{name}\", fn_\{name});\n  if (status_\{name} != napi_ok) return napi_mbt_registration_error(env, status_\{name}, previous, \"Setting export \{name}\");\n",
    )
  }
  out.write_string(class_registration(classes))
  if workers {
    out.write_string(
      "  if (napi_mbt_workers_register(env, exports) != napi_ok) return napi_mbt_registration_error(env, napi_generic_failure, previous, \"Registering worker cleanup\");\n",
    )
  }
  out.write_string("  napi_mbt_leave(previous);\n  return exports;\n}\n")
  out.to_string()
}

///|
fn declarations(
  exports : Array[ParsedExport],
  types : Array[TypeDefinition],
  classes : Array[ParsedClass],
  workers~ : Array[String] = [],
) -> String {
  let body = declarations_types(types) +
    class_declarations(classes) +
    exports
    .map(item => {
      export_documentation(item) +
      "export function \{item.export_name}(\{typescript_parameters(item.parameters, is_async=item.is_async || workers.contains(item.export_name))}): \{typescript_result(item, worker=workers.contains(item.export_name))};"
    })
    .join("\n") +
    "\n"
  "// Auto-generated by napi-mbt. DO NOT EDIT.\n" +
  (if body.contains("AbortSignal") {
    "/// <reference types=\"node\" />\n"
  } else {
    ""
  }) +
  (if body.contains("$NapiBuffer") {
    "import type { Buffer as $NapiBuffer } from 'node:buffer';\n"
  } else {
    ""
  }) +
  (if body.contains("$NapiJson") {
    "export type $NapiJson = null | boolean | number | string | $NapiJson[] | { [key: string]: $NapiJson };\n"
  } else {
    ""
  }) +
  "\n" +
  body
}

///|
fn typescript_parameters(
  parameters : Array[Parameter],
  is_async~ : Bool = false,
) -> String {
  let visible = parameters.filter(p => !(p.value_type is EnvType))
  let params = []
  for i, p in visible {
    let optional = visible[i:].all(p => p.value_type is OptionType(_))
    params.push(
      p.name +
      (if optional { "?: " } else { ": " }) +
      p.value_type.typescript(input=true),
    )
  }
  if is_async {
    let mut name = "options"
    while visible.any(p => p.name == name) {
      name += "_"
    }
    params.push(name + "?: { signal?: AbortSignal }")
  }
  params.join(", ")
}

///|
fn typescript_result(item : ParsedExport, worker~ : Bool = false) -> String {
  let result = item.return_type.typescript()
  if item.is_async || worker {
    "Promise<" + result + ">"
  } else {
    result
  }
}
