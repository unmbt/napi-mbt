///|
fn ts_type(t : String) -> String {
  match t {
    "Int" | "Double" => "number"
    "Bool" => "boolean"
    "String" => "string"
    "Unit" => "void"
    _ => "Buffer"
  }
}

///|
pub fn ParsedExport::manifest(self : ParsedExport) -> Json {
  {
    "sourceName": self.source_name,
    "exportName": self.export_name,
    "params": self.parameters.map(p => {
      ({ "name": p.name, "type": p.type_name } : Json)
    }),
    "ret": self.return_type,
    "throws": self.throws,
    "line": self.line,
    "filename": self.filename,
  }
}

///|
pub fn adapters(exports : Array[ParsedExport]) -> String {
  let out = StringBuilder()
  out.write_string("// Auto-generated by napi-mbt. DO NOT EDIT.\n")
  for item in exports {
    let name = "napi_mbt_adapter_" + item.export_name
    let params = ["env : NapiEnv"]
    for i, _ in item.parameters {
      params.push("a\{i} : NapiValue")
    }
    let line = "pub fn \{name}(\{params.join(", ")}) -> NapiValue {"
    out.write_string("\n///|\n#export_name(\"\{name}\")\n")
    if item.parameters.length() <= 1 && line.length() <= 80 {
      out.write_string(line + "\n")
    } else {
      out.write_string(
        "pub fn \{name}(\n  \{params.join(",\n  ")},\n) -> NapiValue {\n",
      )
    }
    let arguments = []
    let invalidations = StringBuilder()
    for i, p in item.parameters {
      out.write_string("  let p\{i} = get_\{p.type_name}(env, a\{i})\n")
      arguments.push("p\{i}")
      if p.type_name == "NapiBufferView" {
        invalidations.write_string("  p\{i}.invalidate()\n")
      }
    }
    let call = "\{item.source_name}(\{arguments.join(", ")})"
    if item.throws {
      out.write_string(
        "  let result : \{item.return_type} = \{call} catch {\n    error => {\n",
      )
      out.write_string(invalidations.to_string())
      out.write_string(
        "      ignore(napi_throw_error(env, b\"\", @utf8.encode(error.to_string())))\n      return moonbit_dummy_napi_value()\n    }\n  }\n",
      )
    } else {
      out.write_string("  let result : \{item.return_type} = \{call}\n")
    }
    out.write_string(invalidations.to_string())
    out.write_string("  set_\{item.return_type}(env, result)\n}\n")
  }
  out.to_string()
}

///|
pub fn c_glue(exports : Array[ParsedExport]) -> String {
  let out = StringBuilder()
  out.write_string(
    "/* Auto-generated by napi-mbt. DO NOT EDIT. */\n#include <node_api.h>\n#include <stddef.h>\n#include <stdint.h>\n\nextern void moonbit_init(void);\n",
  )
  for item in exports {
    out.write_string(
      "extern napi_value napi_mbt_adapter_\{item.export_name}(napi_env env",
    )
    for _ in item.parameters {
      out.write_string(", napi_value")
    }
    out.write_string(");\n")
  }
  for item in exports {
    let n = item.parameters.length()
    out.write_string(
      "\nstatic napi_value napi_mbt_callback_\{item.export_name}(napi_env env, napi_callback_info info) {\n  size_t argc = \{n};\n  napi_value argv[\{if n > 0 { n } else { 1 }}];\n  napi_status status = napi_get_cb_info(env, info, &argc, argv, NULL, NULL);\n  if (status != napi_ok) return NULL;\n  if (argc < \{n}) { napi_throw_error(env, NULL, \"Missing argument\"); return NULL; }\n",
    )
    // Reject invalid arguments before entering user code or borrowing a Buffer.
    for i, p in item.parameters {
      if p.type_name == "Bytes" || p.type_name == "NapiBufferView" {
        out.write_string(
          "  bool buffer_\{i} = false;\n  if (napi_is_buffer(env, argv[\{i}], &buffer_\{i}) != napi_ok || !buffer_\{i}) { napi_throw_type_error(env, NULL, \"Invalid argument, expected Buffer\"); return NULL; }\n",
        )
      } else {
        let kind = match p.type_name {
          "Bool" => "napi_boolean"
          "String" => "napi_string"
          _ => "napi_number"
        }
        out.write_string(
          "  napi_valuetype type_\{i};\n  if (napi_typeof(env, argv[\{i}], &type_\{i}) != napi_ok || type_\{i} != \{kind}) { napi_throw_type_error(env, NULL, \"Invalid argument, expected \{p.type_name}\"); return NULL; }\n",
        )
      }
    }
    out.write_string("  return napi_mbt_adapter_\{item.export_name}(env")
    for i in 0..<n {
      out.write_string(", argv[\{i}]")
    }
    out.write_string(");\n}\n")
  }
  out.write_string(
    "\n#if defined(_WIN32)\n#define NAPI_MBT_EXPORT __declspec(dllexport)\n#else\n#define NAPI_MBT_EXPORT __attribute__((visibility(\"default\")))\n#endif\n\nNAPI_MBT_EXPORT napi_value napi_register_module_v1(napi_env env, napi_value exports) {\n  moonbit_init();\n",
  )
  for item in exports {
    let name = item.export_name
    out.write_string(
      "  napi_value fn_\{name};\n  napi_create_function(env, \"\{name}\", NAPI_AUTO_LENGTH, napi_mbt_callback_\{name}, NULL, &fn_\{name});\n  napi_set_named_property(env, exports, \"\{name}\", fn_\{name});\n",
    )
  }
  out.write_string("  return exports;\n}\n")
  out.to_string()
}

///|
pub fn declarations(exports : Array[ParsedExport]) -> String {
  "// Auto-generated by napi-mbt. DO NOT EDIT.\n\n" +
  exports
  .map(item => {
    let params = item.parameters
      .map(p => p.name + ": " + ts_type(p.type_name))
      .join(", ")
    "export function \{item.export_name}(\{params}): \{ts_type(item.return_type)};"
  })
  .join("\n") +
  "\n"
}

///|
pub fn loaders(
  exports : Array[ParsedExport],
  package_name : String,
  version : Int,
) -> (String, String) {
  let name = (package_name + "-").to_json().stringify()
  let cjs =
    $|const path = require('path');
    $|const requiredNapi = \{version};
    $|const actualNapi = Number(process.versions && process.versions.napi || 0);
    $|if (actualNapi < requiredNapi) throw new Error('This native module requires N-API ' + requiredNapi + ', found ' + actualNapi);
    $|let target = process.platform + '-' + process.arch;
    $|if (process.platform === 'win32') target += '-msvc';
    $|if (process.platform === 'linux') target += '-gnu';
    $|let addon;
    $|try { addon = require(\{name} + target); } catch (e) { addon = require(path.join(__dirname, 'artifacts', target, 'napi_mbt.node')); }
    $|module.exports = addon;
    $|
  let esm = "import { createRequire } from 'module';\nconst require = createRequire(import.meta.url);\nconst addon = require('./index.cjs');\nexport default addon;\n" +
    exports
    .map(item => "export const \{item.export_name} = addon.\{item.export_name};")
    .join("\n") +
    "\n"
  (cjs, esm)
}
