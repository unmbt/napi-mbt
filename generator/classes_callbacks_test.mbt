///|
fn counter_config() -> @generator.ClassConfig {
  {
    name: "Counter",
    type_name: "Counter",
    construct: "Counter::new",
    methods: [("add", "Counter::add")],
    static_methods: [],
    properties: [],
  }
}

///|
let counter_source : String =
  #|struct Counter { mut value : Int }
  #|fn Counter::new(value : Int) -> Counter { { value, } }
  #|fn Counter::add(self : Counter, n : Int) -> Int { self.value += n; self.value }
  #|fn Counter::hidden(self : Counter) -> Int { self.value }

///|
test "class configuration resolves private members and hides unlisted methods" {
  let source = @generator.parse_sources([("counter.mbt", counter_source)], classes=[
    counter_config(),
  ])
  assert_eq(source.classes.length(), 1)
  assert_eq(source.classes[0].members.length(), 1)
  assert_eq(source.native_exports(), [
    "moonbit_init", "napi_mbt_adapter_class_0_construct", "napi_mbt_adapter_class_0_method_0",
    "napi_mbt_class_dispose_0",
  ])
  assert_eq(
    rendered(source, "index.d.ts"),
    "// Auto-generated by napi-mbt. DO NOT EDIT.\n\nexport class Counter {\n  private readonly $napiType: never;\n  constructor(value: number);\n  dispose(): void;\n  add(n: number): number;\n}\n\n\n",
  )
}

///|
test "class constructors receivers members and adapter collisions are validated" {
  for
    source in [
      counter_source.replace_all(
        old="-> Counter { { value, } }",
        new="-> Int { value }",
      ),
      counter_source.replace_all(old="self : Counter, n", new="self : Int, n"),
      counter_source +
      "\n#export_name(\"class_0_construct\")\npub fn collide() -> Int { 1 }",
    ] {
    try {
      let parsed = @generator.parse_sources([("invalid.mbt", source)], classes=[
        counter_config(),
      ])
      ignore(rendered(parsed, "napi_exports.mbt"))
    } catch {
      _ => ()
    } noraise {
      _ => fail("Expected class rejection")
    }
  }
}

///|
test "callback signatures preserve nested arrows and independent error annotations" {
  let parsed = @generator.parse_source(
    "#export_name(\"wrap\")\npub fn wrap(f : (Int) -> Int raise) -> ((Int) -> Int raise) { f }",
    "callback.mbt",
  )
  assert_true(!parsed.exports[0].throws)
  assert_true(
    parsed.exports[0].parameters[0].value_type
    is CallbackType([IntType], IntType, true),
  )
  assert_true(
    parsed.exports[0].return_type is CallbackType([IntType], IntType, true),
  )
  assert_eq(
    rendered(parsed, "index.d.ts"),
    "// Auto-generated by napi-mbt. DO NOT EDIT.\n\nexport function wrap(f: (((arg0: number) => number))): (((arg0: number) => number) & { dispose(): void });\n",
  )
  for
    parameter in [
      "(Int) -> Int", "(NapiBufferView) -> Int raise", "() -> NapiBufferView raise",
    ] {
    try {
      let parsed = @generator.parse_source(
        "#export_name(\"f\")\npub fn f(value : \{parameter}) -> Unit { () }",
        "invalid.mbt",
      )
      ignore(rendered(parsed, "index.d.ts"))
    } catch {
      _ => ()
    } noraise {
      _ => fail("Expected callback rejection")
    }
  }
}
