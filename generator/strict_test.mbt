///|
fn rendered(source : @generator.ParsedSource, name : String) -> String raise {
  for
    (file, content) in @generator.render(
      source,
      "fixture",
      7,
      package_version="0.1.0",
    ) {
    if file == name {
      return content
    }
  }
  fail("Missing output \{name}")
}

///|
test "formatted Int32 uses the same numeric conversion as Int" {
  let source = "#export_name(\"identity\")\npub fn identity(value : Int32) -> Int32 { value }"
  let parsed = @generator.parse_source(source, "formatted.mbt")
  assert_true(parsed.exports[0].parameters[0].value_type is IntType)
  assert_true(parsed.exports[0].return_type is IntType)
  assert_eq(
    rendered(parsed, "index.d.ts"),
    "// Auto-generated by napi-mbt. DO NOT EDIT.\n\n/**\n * @throws Node-API errors carry code, status and context; existing JS exceptions preserve identity.\n * @throws Argument conversion failure prevents business execution.\n */\nexport function identity(value: number): number;\n",
  )
}

///|
test "strict parser validates complete syntax and ignores comments and strings" {
  let source =
    #|// #export_name("fake")
    #|let example = "#export_name(\"fake\") napi_bigint"
    #|#export_name("sum")
    #|pub fn add(
    #| a : Int,
    #| b : Int,
    #|) -> Int { a + b }
  let parsed = @generator.parse_source(source, "fixture.mbt")
  assert_eq(parsed.exports.length(), 1)
  assert_true(parsed.exports[0].return_type is IntType)
  assert_eq(parsed.exports[0].parameters.length(), 2)
  assert_eq(parsed.features.length(), 0)
  assert_eq(
    @generator.parse_source(
      source.replace_all(old="\n", new="\r\n"),
      "fixture.mbt",
    ).exports[0].line,
    parsed.exports[0].line,
  )
}

///|
test "strict parser rejects unsupported and malformed exports" {
  for
    source in [
      "#export_name\npub fn f() -> Unit { () }", "pub fn broken(", "#export_name(\"class\")\npub fn f() -> Unit { () }",
      "#export_name(\"x\")\npub fn f(a : Unknown) -> Unit { () }",
    ] {
    try @generator.parse_source(source, "invalid.mbt") catch {
      _ => ()
    } noraise {
      _ => fail("Expected rejection")
    }
  }
}

///|
test "labeled and optional parameters generate valid calls and optional TS signatures" {
  let parsed = @generator.parse_source(
    "/// Add values.\n#export_name(\"compute\")\npub fn compute(base~ : Int, step? : Int = 2, note? : String) -> Int { ignore(note); base + step }",
    "labeled.mbt",
  )
  let exports_mbt = rendered(parsed, "napi_exports.mbt")
  assert_true(exports_mbt.contains("let p0 : Int32 = napi_from_value(env, a0)"))
  assert_true(
    exports_mbt.contains("let p1 : Option[Int32] = napi_from_value(env, a1)"),
  )
  assert_true(
    exports_mbt.contains("let p2 : Option[String] = napi_from_value(env, a2)"),
  )
  assert_true(exports_mbt.contains("compute(base=p0, step?=p1, note?=p2)"))
  let dts = rendered(parsed, "index.d.ts")
  assert_true(
    dts.contains(
      "compute(base: number, step?: (number | null | undefined), note?: (string | null | undefined)): number;",
    ),
  )
  let c_glue = rendered(parsed, "napi_glue.c")
  assert_true(c_glue.contains("if (argc < 1)"))
}

///|
test "enum value directives and doc class/module_exports directives render and strip @napi comments" {
  let source =
    #|/// Custom HTTP role.
    #|/// @napi value("admin")
    #|/// @napi value("user")
    #|
    #|/// Http mode.
    #|pub(all) enum Role {
    #|  /// @napi value("admin-role")
    #|  Admin
    #|  /// @napi value("guest-role")
    #|  Guest
    #|}
    #|
    #|/// Box doc.
    #|/// @napi class("Box")
    #|pub struct NativeBox { mut v : Int }
    #|/// @napi constructor
    #|pub fn NativeBox::new(v~ : Int) -> NativeBox { { v, } }
    #|/// @napi getter("value")
    #|pub fn NativeBox::get_value(self : NativeBox) -> Int { self.v }
    #|/// @napi setter("value")
    #|pub fn NativeBox::set_value(self : NativeBox, v : Int) -> Unit { self.v = v }
    #|/// Increments internal value.
    #|/// @napi method("bump")
    #|pub fn NativeBox::inc(self : NativeBox, delta? : Int = 1) -> Int { self.v += delta; self.v }
    #|/// @napi static("fromDefault")
    #|pub fn NativeBox::make() -> NativeBox { { v: 7 } }
    #|
    #|/// @napi module_exports
    #|pub fn init_exports(env : NapiEnv, exports : NapiObject) -> Unit raise {
    #|  exports.set(env, "version", set_String(env, "1.0.0"))
    #|}
    #|
    #|/// Read role.
    #|#export_name("echoRole")
    #|pub fn echo_role(r : Role) -> Role { r }
    #|
  let clean_source = source.replace_all(
    old="/// Custom HTTP role.\n/// @napi value(\"admin\")\n/// @napi value(\"user\")\n\n",
    new="",
  )
  let parsed = @generator.parse_source(clean_source, "directives.mbt")
  assert_eq(parsed.classes.length(), 1)
  assert_eq(parsed.classes[0].name, "Box")
  assert_true(parsed.module_exports is Some(_))
  assert_true(parsed.native_exports().contains("napi_mbt_module_exports"))
  let dts = rendered(parsed, "index.d.ts")
  assert_true(!dts.contains("@napi"))
  assert_true(
    dts.contains("export type Role = \"admin-role\" | \"guest-role\";"),
  )
  assert_true(dts.contains("export class Box {"))
  assert_true(dts.contains("get value(): number;"))
  assert_true(dts.contains("set value(value: number);"))
  assert_true(
    dts.contains("bump(delta?: (number | null | undefined)): number;"),
  )
  assert_true(dts.contains("static fromDefault(): Box;"))
  let exports_mbt = rendered(parsed, "napi_exports.mbt")
  assert_true(exports_mbt.contains("\"admin-role\" =>"))
  assert_true(exports_mbt.contains("napi_mbt_module_exports"))
  let c_glue = rendered(parsed, "napi_glue.c")
  assert_true(c_glue.contains("napi_mbt_module_exports(env, exports)"))
}

///|
test "strict emitter invalidates borrowed buffer after call on success and error" {
  let parsed = @generator.parse_source(
    "#export_name(\"touch\")\npub fn touch(buf : NapiBufferView) -> Unit raise { () }",
    "a.mbt",
  )
  assert_true(parsed.exports[0].throws)
  let output = rendered(parsed, "napi_exports.mbt")
  assert_true(output.contains("defer p0.invalidate()"))
  assert_true(output.contains("throw_napi_error(env, error)"))
  let call = output.find("touch(p0)").unwrap()
  assert_true(output.find("defer p0.invalidate()").unwrap() < call)
  assert_true(rendered(parsed, "napi_glue.c").contains("ERR_NAPI_REGISTER"))
}

///|
test "zero argument Unit, noraise and Unicode source positions" {
  let source = "// 你好🌙\n#export_name(\"noop\")\npub fn noop() -> Unit noraise { () }"
  let parsed = @generator.parse_source(source, "unicode.mbt")
  assert_eq(parsed.exports[0].line, 2)
  assert_eq(parsed.exports[0].parameters.length(), 0)
  assert_true(!parsed.exports[0].throws)
  assert_true(rendered(parsed, "napi_glue.c").contains("napi_value argv[1]"))
  assert_true(rendered(parsed, "index.d.ts").contains("noop(): void"))
}

///|
test "N-API feature detection ignores comments and strings" {
  let parsed = @generator.parse_source(
    "fn f() {\n // napi_create_bigint_int64\n let _ = \"napi_create_promise\"\n napi_create_threadsafe_function()\n}",
    "features.mbt",
  )
  assert_eq(parsed.features, ["threadsafe_function"])
}

///|
test "Unicode source names and associated functions remain callable" {
  let unicode = @generator.parse_source(
    "#export_name(\"greet\")\npub fn 问候() -> Int { 1 }", "unicode.mbt",
  )
  assert_eq(unicode.exports[0].source_name, "问候")
  assert_true(rendered(unicode, "napi_exports.mbt").contains("问候()"))
  let associated = @generator.parse_source(
    "#export_name(\"plus\")\npub fn Int::plus(self : Int) -> Int { self + 1 }", "method.mbt",
  )
  assert_eq(associated.exports[0].source_name, "Int::plus")
  assert_true(
    rendered(associated, "napi_exports.mbt").contains("Int::plus(p0)"),
  )
}

///|
test "signature comments and async text do not change syntax" {
  let source =
    #|#export_name("async_job")
    #|pub fn
    #| run(
    #|   a : // argument
    #|     Int,
    #| ) -> // result
    #| Int { a }
  let parsed = @generator.parse_source(source, "comments.mbt")
  assert_eq(parsed.exports[0].source_name, "run")
  assert_true(parsed.exports[0].parameters[0].value_type is IntType)
  assert_true(parsed.exports[0].return_type is IntType)
  for
    invalid in [
      "#export_name(\"f\")\nasync fn f() -> Unit { () }", "#export_name(\"f\")\nfn[T] f() -> Unit { () }",
    ] {
    try @generator.parse_source(invalid, "invalid.mbt") catch {
      _ => ()
    } noraise {
      _ => fail("Expected rejection")
    }
  }
}

///|
test "derive attribute on exported struct parses cleanly" {
  let source =
    #|#derive(Debug)
    #|pub(all) struct DerivedRecord {
    #|  label : String
    #|  count : Int
    #|}
    #|
    #|#export_name("echo_derived")
    #|pub fn echo_derived(item : DerivedRecord) -> DerivedRecord { item }
  let parsed = @generator.parse_source(source, "derived.mbt")
  assert_eq(parsed.exports.length(), 1)
  assert_eq(parsed.types.length(), 1)
}
