///|
test "documentation is attached through syntax and escapes TypeScript comment endings" {
  let source = @generator.parse_source(
    "///|\n/// 名称与说明。\n/// Text */ must remain a comment.\n#export_name(\"echo\")\npub fn echo(value : String) -> String { value }\n///|\n#export_name(\"plain\")\npub fn plain() -> Unit { () }",
    "docs.mbt",
  )
  assert_eq(source.exports[0].documentation, [
    "名称与说明。", "Text */ must remain a comment.",
  ])
  assert_eq(source.exports[1].documentation, [])
  guard source.exports[0].manifest()
    is { "documentation": Array(documentation), .. } else {
    fail("Missing documentation")
  }
  assert_eq(documentation, [
    Json("名称与说明。"),
    Json("Text */ must remain a comment."),
  ])
  assert_eq(
    rendered(source, "index.d.ts"),
    "// Auto-generated by napi-mbt. DO NOT EDIT.\n\n/**\n * 名称与说明。\n * Text * /  must remain a comment.\n * @throws Node-API errors carry code, status and context; existing JS exceptions preserve identity.\n * @throws Argument conversion failure prevents business execution.\n */\nexport function echo(value: string): string;\n/**\n * @throws Node-API errors carry code, status and context; existing JS exceptions preserve identity.\n */\nexport function plain(): void;\n",
  )
}

///|
test "type documentation and Buffer imports come from the resolved IR" {
  let source = @generator.parse_source(
    "///|\n/// Payload documentation.\npub(all) struct Payload { data : Bytes }\n#export_name(\"payload\")\npub fn payload(value : Payload) -> Payload { value }",
    "types.mbt",
  )
  assert_eq(source.types[0].documentation, ["Payload documentation."])
  assert_eq(source.exports[0].error_contract(), [
    "Node-API errors carry code, status and context; existing JS exceptions preserve identity.",
    "Argument conversion failure prevents business execution.",
  ])
  assert_true(
    rendered(source, "index.d.ts").has_prefix(
      "// Auto-generated by napi-mbt. DO NOT EDIT.\nimport type { Buffer as $NapiBuffer } from 'node:buffer';",
    ),
  )
}
