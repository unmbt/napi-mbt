///|
test "type resolution spans files and infers nested feature requirements" {
  let source = @generator.parse_sources([
    (
      "types.mbt", "pub(all) struct Item { id : Int64; values : Array[UInt64?] }",
    ),
    (
      "api.mbt", "#export_name(\"echo\")\npub fn echo(value : Item) -> Item { value }",
    ),
  ])
  assert_eq(source.types.length(), 1)
  assert_eq(source.types[0].name, "Item")
  assert_eq(source.features, ["bigint"])
  assert_eq(source.exports[0].filename, "api.mbt")
  try @generator.render(source, "fixture", 4, package_version="0.1.0") catch {
    _ => ()
  } noraise {
    _ => fail("Expected bigint NAPI validation")
  }
}

///|
test "unsupported unresolved generic and nested borrow types fail with a location" {
  for
    text in [
      "Unknown", "Array[Unknown]", "Map[String,Int]", "NapiBufferView?", "Array[NapiBufferView]",
      "Array[Unit]",
    ] {
    try
      @generator.parse_source(
        "#export_name(\"echo\")\npub fn echo(value : \{text}) -> Unit { () }",
        "bad.mbt",
      )
    catch {
      error => assert_true(error.to_string().contains("bad.mbt:1"))
    } noraise {
      _ => fail("Expected rejection for \{text}")
    }
  }
}

///|
test "only nullable trailing parameters are optional in TypeScript" {
  let source = @generator.parse_source(
    "#export_name(\"optional\")\npub fn optional(a : Int?, b : Int, c : Int?) -> Int? { c }",
    "options.mbt",
  )
  let files = @generator.render(source, "fixture", 4, package_version="0.1.0")
  for (name, text) in files {
    if name == "index.d.ts" {
      assert_eq(
        text, "// Auto-generated by napi-mbt. DO NOT EDIT.\n\nexport function optional(a: (number | null | undefined), b: number, c?: (number | null | undefined)): (number | null);\n",
      )
    }
  }
}

///|
test "recursive named types resolve without recursively expanding the IR" {
  let source = @generator.parse_source(
    "pub(all) enum Tree { Leaf(Int); Branch(Array[Tree]) }\n#export_name(\"echo\")\npub fn echo(value : Tree) -> Tree { value }",
    "tree.mbt",
  )
  assert_eq(source.types.length(), 1)
  assert_eq(source.types[0].name, "Tree")
  assert_eq(source.exports.length(), 1)
}
