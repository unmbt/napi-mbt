{
  "name": "napi-mbt",
  "version": "0.2.1",
  "private": true,
  "description": "MoonBit N-API bindings and native Node.js addon tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/unmbt/napi-mbt.git"
  },
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "licenses",
    "index.d.ts",
    "napi_manifest.json",
    "index.cjs",
    "index.d.cts",
    "index.mjs",
    "index.d.mts"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "default": "./index.cjs"
    }
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --test scripts/test.js"
  },
  "engines": {
    "node": ">=12.20.0 <13 || >=14.13.1",
    "pnpm": ">=10"
  }
}
