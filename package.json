{
  "name": "napi-mbt",
  "version": "0.1.0",
  "description": "MoonBit N-API bindings and native Node.js addon tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/unmbt/napi-mbt.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": ["index.cjs", "index.mjs", "index.d.ts", "README.md", "README.zh.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "import": "./index.mjs",
      "default": "./index.cjs"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test scripts/test.js",
    "publish:dry-run": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js"
  },
  "optionalDependencies": {
    "napi-mbt-win32-x64-msvc": "0.1.0",
    "napi-mbt-darwin-arm64": "0.1.0",
    "napi-mbt-linux-x64-gnu": "0.1.0"
  }
}
