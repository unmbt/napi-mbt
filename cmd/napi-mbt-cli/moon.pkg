import {
  "unmbt/native-toolchain" @native_toolchain,
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "unmbt/napi-mbt/generator",
  "unmbt/napi-mbt/internal/assets",
}

pkgtype(kind: "executable")

supported_targets = "native"

rule(
  name: "gen_version",
  command: "moon run scripts/gen_version.mbtx $input $output",
)

dev_build(
  rule: "gen_version",
  input: "../../moon.mod",
  output: "generated_version.mbt",
)

options(
  "native-stub": [ "host.c" ],
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/fs",
  ],
)
