  if (class_1_status != napi_ok) return napi_mbt_registration_error(env, class_1_status, previous, "Retaining class constructor");
  class_1_status = moonbit_napi_field_set(env, exports, "Other", class_1);
  if (class_1_status != napi_ok) return napi_mbt_registration_error(env, class_1_status, previous, "Exporting class");
  napi_mbt_leave(previous);
  return exports;
}
