{
  "name": "structured-fixture",
  "version": "0.1.0",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "default": "./index.cjs"
    }
  },
  "scripts": {
    "test": "node test/smoke.cjs && node test/smoke.mjs"
  },
  "engines": {
    "pnpm": ">=10",
    "node": ">=12.20.0 <13 || >=14.13.1"
  },
  "files": [
    "licenses",
    "index.d.ts",
    "napi_manifest.json",
    "index.cjs",
    "index.d.cts",
    "index.mjs",
    "index.d.mts"
  ]
}
