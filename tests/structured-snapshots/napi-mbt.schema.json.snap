{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "napi-mbt configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "napiVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 4
    },
    "builder": {
      "enum": [
        "auto",
        "cmake",
        "gcc",
        "clang",
        "msvc"
      ],
      "default": "auto"
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "win32-x64-msvc",
          "darwin-x64",
          "darwin-arm64",
          "linux-x64-gnu",
          "linux-arm64-gnu",
          "linux-x64-musl",
          "linux-arm64-musl"
        ]
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "promise",
          "threadsafe_function",
          "bigint",
          "buffer",
          "class",
          "callback",
          "async",
          "native_tasks",
          "streams",
          "type_tag",
          "freeze",
          "seal",
          "external",
          "zero_copy",
          "binary_extended",
          "instance_data",
          "symbol_for",
          "syntax_error",
          "module_filename",
          "property_key",
          "external_string",
          "buffer_from_arraybuffer",
          "typed_tsfn"
        ]
      }
    },
    "cjs": {
      "type": "boolean",
      "default": true
    },
    "esm": {
      "type": "boolean",
      "default": true
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "constructor"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "constructor": {
            "type": "string",
            "minLength": 1
          },
          "methods": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "staticMethods": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "get": {
                  "type": "string",
                  "minLength": 1
                },
                "set": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": [
                    "get"
                  ]
                },
                {
                  "required": [
                    "set"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "workerTasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workerPool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 2
        },
        "maxQueue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 64
        },
        "idleTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 30000
        }
      }
    },
    "nativeTasks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    }
  },
  "not": {
    "required": [
      "cjs",
      "esm"
    ],
    "properties": {
      "cjs": {
        "const": false
      },
      "esm": {
        "const": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "promise"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "threadsafe_function"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 4
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "bigint"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 6
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "buffer"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 7
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "class"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "callback"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "async"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "native_tasks"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "streams"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "type_tag"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "freeze"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "seal"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "external"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "zero_copy"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "binary_extended"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 7
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "instance_data"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 6
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "symbol_for"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 9
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "syntax_error"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 9
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "module_filename"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 9
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "property_key"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 10
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "external_string"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 10
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "buffer_from_arraybuffer"
            }
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 10
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "contains": {
              "const": "typed_tsfn"
            }
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 4
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workerTasks"
        ],
        "properties": {
          "workerTasks": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "nativeTasks"
        ],
        "properties": {
          "nativeTasks": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "required": [
          "napiVersion"
        ],
        "properties": {
          "napiVersion": {
            "minimum": 8
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "classes"
        ],
        "properties": {
          "classes": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "napiVersion": {
            "minimum": 3
          }
        }
      }
    }
  ]
}
