/* Per-environment worker pool and event waiter. No process signal handlers are
 * installed. Windows uses CancelSynchronousIo; POSIX uses pthread_cancel only
 * inside cancellable regions. MoonBit RC stays on the host thread. */
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#ifndef _WIN32
#include <fcntl.h>
#include <pthread.h>
#include <signal.h>
#include <stdatomic.h>
#include <unistd.h>
#include <poll.h>
typedef int HANDLE;
#define GetLastError() errno
#define SetLastError(err) errno = (err)
typedef _Atomic int32_t atomic_int32_t;
#else
typedef volatile int32_t atomic_int32_t;
#endif

struct job {
  int32_t ret;
  int32_t err;
  int32_t (*worker)(void *, int32_t *);
  void (*free)(void *);
  int32_t (*cancel_handler)(void *);
  char payload[];
};
#define JOB_HEADER(payload_ptr) ((struct job *)(payload_ptr) - 1)

struct napi_mbt_async_pool {
  int initialized;
  HANDLE notify_send;
  HANDLE notify_recv;
#ifndef _WIN32
  sigset_t old_sigmask;
#endif
};
#ifdef _WIN32
#define NAPI_MBT_ASYNC_TLS __declspec(thread)
#else
#define NAPI_MBT_ASYNC_TLS _Thread_local
#endif
static NAPI_MBT_ASYNC_TLS struct napi_mbt_async_pool *active_pool;
static NAPI_MBT_ASYNC_TLS struct worker *current_worker;
#define pool (*active_pool)

MOONBIT_FFI_EXPORT void *napi_mbt_async_pool_current(void) { return active_pool; }
MOONBIT_FFI_EXPORT void *napi_mbt_async_pool_null(void) { return NULL; }
MOONBIT_FFI_EXPORT void *napi_mbt_async_pool_swap(void *next) {
  void *previous = active_pool; active_pool = next; return previous;
}

enum WorkerState { Running = 0, Cancelling, Cancelled, Waiting };
struct worker {
#ifdef _WIN32
  HANDLE id;
  HANDLE event;
#else
  pthread_t id;
  int thread_valid;
#endif
  struct napi_mbt_async_pool *owner;
  int32_t job_id;
  struct job *job;
  atomic_int32_t state;
  atomic_int32_t inside_cancellable_region;
};
enum { CANCELLATION_STATUS_RETRY_LATER = 0, CANCELLATION_STATUS_NEED_WAIT = 1 };

static void napi_mbt_async_notify_event_loop(int32_t data) {
#ifdef _WIN32
  PostQueuedCompletionStatus(pool.notify_send, data, (ULONG_PTR)pool.notify_recv, 0);
#else
  while (write(pool.notify_send, &data, sizeof(data)) < 0 && errno == EINTR) {}
#endif
}

void *napi_mbt_async_get_current_worker(void) { return current_worker; }

#ifndef _WIN32
static void worker_cancelled(void *data) {
  struct worker *worker = data;
  worker->job->ret = -1;
  worker->job->err = ECANCELED;
  worker->inside_cancellable_region = 0;
  worker->state = Waiting;
  napi_mbt_async_notify_event_loop(worker->job_id);
}
static void *worker_loop(void *data) {
  struct worker *worker = data;
  active_pool = worker->owner;
  current_worker = worker;
  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);
  pthread_cleanup_push(worker_cancelled, worker);
  worker->job->err = 0;
  worker->job->ret = worker->job->worker(worker->job->payload, &worker->job->err);
  worker->inside_cancellable_region = 0;
  worker->state = Waiting;
  napi_mbt_async_notify_event_loop(worker->job_id);
  pthread_cleanup_pop(0);
  return NULL;
}
#else
static DWORD WINAPI worker_loop(void *data) {
  struct worker *worker = data;
  active_pool = worker->owner;
  current_worker = worker;
  while (worker->job) {
    worker->job->err = 0;
    worker->job->ret = worker->job->worker(worker->job->payload, &worker->job->err);
    worker->inside_cancellable_region = 0;
    worker->state = Waiting;
    napi_mbt_async_notify_event_loop(worker->job_id);
    WaitForSingleObject(worker->event, INFINITE);
  }
  return 0;
}
#endif

int32_t napi_mbt_async_enter_cancellable_region(void *ptr) {
  struct worker *worker = (struct worker *)ptr;
  if (!worker) return 0;
  worker->inside_cancellable_region = 1;
  if (worker->state == Cancelling) {
    worker->state = Cancelled;
    worker->inside_cancellable_region = 0;
    return 1;
  }
#ifndef _WIN32
  pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);
  pthread_testcancel();
#endif
  return 0;
}
void napi_mbt_async_leave_cancellable_region(void *ptr) {
  struct worker *worker = (struct worker *)ptr;
  if (!worker) return;
#ifndef _WIN32
  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);
#endif
  worker->inside_cancellable_region = 0;
}
MOONBIT_FFI_EXPORT void napi_mbt_async_worker_enter_idle(struct worker *worker) {
  worker->job = NULL;
}
MOONBIT_FFI_EXPORT int32_t napi_mbt_async_cancel_worker(struct worker *worker) {
  int32_t state = worker->state;
  if (state == Cancelled || state == Waiting) return CANCELLATION_STATUS_NEED_WAIT;
  worker->state = Cancelling;
  if (worker->job->cancel_handler) return worker->job->cancel_handler(worker->job->payload);
#ifdef _WIN32
  if (CancelSynchronousIo(worker->id)) return CANCELLATION_STATUS_NEED_WAIT;
  return GetLastError() == ERROR_NOT_FOUND ? CANCELLATION_STATUS_RETRY_LATER : -1;
#else
  int result = pthread_cancel(worker->id);
  if (result) { errno = result; return -1; }
  return CANCELLATION_STATUS_NEED_WAIT;
#endif
}
MOONBIT_FFI_EXPORT int32_t napi_mbt_async_worker_check_cancellation_retry(struct worker *worker) {
  if (worker->state == Waiting) return 0;
  napi_mbt_async_cancel_worker(worker);
  return 1;
}

MOONBIT_FFI_EXPORT void napi_mbt_async_wake_worker(struct worker *worker, int32_t job_id, void *job) {
#ifndef _WIN32
  if (worker->thread_valid) pthread_join(worker->id, NULL);
  worker->thread_valid = 0;
#endif
  worker->job_id = job_id;
  worker->job = job ? JOB_HEADER(job) : NULL;
  worker->state = Running;
#ifdef _WIN32
  SetEvent(worker->event);
#else
  if (worker->job) {
    int status = pthread_create(&worker->id, NULL, worker_loop, worker);
    if (status) {
      worker->job->ret = -1; worker->job->err = status; worker->state = Waiting;
      napi_mbt_async_notify_event_loop(job_id);
    } else worker->thread_valid = 1;
  }
#endif
}
MOONBIT_FFI_EXPORT void napi_mbt_async_free_worker(struct worker *worker) {
#ifdef _WIN32
  napi_mbt_async_wake_worker(worker, 0, NULL);
  WaitForSingleObject(worker->id, INFINITE);
  CloseHandle(worker->id);
  CloseHandle(worker->event);
#else
  if (worker->thread_valid) pthread_join(worker->id, NULL);
#endif
  free(worker);
}

#ifndef _WIN32
int moonbitlang_async_event_bus_register(int event_bus, int fd, int32_t read_only);
#endif
MOONBIT_FFI_EXPORT HANDLE napi_mbt_async_init_thread_pool(HANDLE event_bus) {
  if (active_pool) {
#ifdef _WIN32
    SetLastError(ERROR_INVALID_STATE); return NULL;
#else
    errno = EBUSY; return -1;
#endif
  }
  active_pool = calloc(1, sizeof(*active_pool));
  if (!active_pool) {
#ifdef _WIN32
    SetLastError(ERROR_OUTOFMEMORY); return NULL;
#else
    errno = ENOMEM; return -1;
#endif
  }
#ifdef _WIN32
  pool.notify_send = pool.notify_recv = event_bus;
#else
  pthread_sigmask(SIG_SETMASK, NULL, &pool.old_sigmask);
  int pipefds[2];
  if (pipe(pipefds) < 0) { free(active_pool); active_pool = NULL; return -1; }
  pool.notify_recv = pipefds[0]; pool.notify_send = pipefds[1];
  for (int i = 0; i < 2; ++i) {
    int flags = fcntl(pipefds[i], F_GETFD);
    if (flags < 0 || fcntl(pipefds[i], F_SETFD, flags | FD_CLOEXEC) < 0) goto failed;
  }
  if (moonbitlang_async_event_bus_register(event_bus, pool.notify_recv, 1) < 0) goto failed;
#endif
  pool.initialized = 1;
  return pool.notify_recv;
#ifndef _WIN32
failed:
  { int saved = errno; close(pipefds[0]); close(pipefds[1]); free(active_pool); active_pool = NULL; errno = saved; return -1; }
#endif
}
MOONBIT_FFI_EXPORT void napi_mbt_async_destroy_thread_pool(void) {
  if (!active_pool) return;
#ifndef _WIN32
  close(pool.notify_recv); close(pool.notify_send);
#endif
  free(active_pool); active_pool = NULL;
}

MOONBIT_FFI_EXPORT struct worker *napi_mbt_async_spawn_worker(int32_t init_job_id, void *init_job) {
  struct worker *worker = calloc(1, sizeof(*worker));
  if (!worker) {
#ifdef _WIN32
    SetLastError(ERROR_OUTOFMEMORY);
#else
    errno = ENOMEM;
#endif
    return NULL;
  }
  worker->owner = active_pool;
  worker->job_id = init_job_id;
  worker->job = JOB_HEADER(init_job);
  worker->state = Running;
#ifdef _WIN32
  worker->event = CreateEventA(NULL, FALSE, FALSE, NULL);
  if (!worker->event) { free(worker); return NULL; }
  worker->id = CreateThread(NULL, 0, worker_loop, worker, 0, NULL);
  if (!worker->id) { CloseHandle(worker->event); free(worker); return NULL; }
#else
  int status = pthread_create(&worker->id, NULL, worker_loop, worker);
  if (status) { free(worker); errno = status; return NULL; }
  worker->thread_valid = 1;
#endif
  return worker;
}
MOONBIT_FFI_EXPORT int32_t napi_mbt_async_worker_is_null(struct worker *worker) { return worker == NULL; }

#ifndef _WIN32
MOONBIT_FFI_EXPORT int32_t napi_mbt_async_fetch_completion(int notify_recv, int32_t *output) {
  int max_len = Moonbit_array_length(output);
  return (int32_t)read(notify_recv, (char *)output, (size_t)max_len * sizeof(int32_t));
}
#endif

/* Per-environment background event-bus waiter for event-driven host wakeup. */
extern int32_t moonbitlang_async_event_bus_wait(HANDLE bus, int32_t timeout);
extern void *moonbitlang_async_event_list_get(HANDLE bus, int32_t index);

#ifdef _WIN32
typedef CRITICAL_SECTION napi_mbt_wmutex_t;
typedef CONDITION_VARIABLE napi_mbt_wcond_t;
#define napi_mbt_wmutex_init(m) InitializeCriticalSection(m)
#define napi_mbt_wmutex_destroy(m) DeleteCriticalSection(m)
#define napi_mbt_wmutex_lock(m) EnterCriticalSection(m)
#define napi_mbt_wmutex_unlock(m) LeaveCriticalSection(m)
#define napi_mbt_wcond_init(c) InitializeConditionVariable(c)
#define napi_mbt_wcond_destroy(c) (void)0
#define napi_mbt_wcond_signal(c) WakeConditionVariable(c)
static int32_t napi_mbt_wcond_wait(napi_mbt_wcond_t *c, napi_mbt_wmutex_t *m) {
  return SleepConditionVariableCS(c, m, INFINITE) ? 0 : -1;
}
#else
typedef pthread_mutex_t napi_mbt_wmutex_t;
typedef pthread_cond_t napi_mbt_wcond_t;
#define napi_mbt_wmutex_init(m) pthread_mutex_init(m, NULL)
#define napi_mbt_wmutex_destroy(m) pthread_mutex_destroy(m)
#define napi_mbt_wmutex_lock(m) pthread_mutex_lock(m)
#define napi_mbt_wmutex_unlock(m) pthread_mutex_unlock(m)
#define napi_mbt_wcond_init(c) pthread_cond_init(c, NULL)
#define napi_mbt_wcond_destroy(c) pthread_cond_destroy(c)
#define napi_mbt_wcond_signal(c) pthread_cond_signal(c)
static int32_t napi_mbt_wcond_wait(napi_mbt_wcond_t *c, napi_mbt_wmutex_t *m) {
  int ret = pthread_cond_wait(c, m);
  if (!ret) return 0;
#ifdef __MACH__
  if (ret == EINVAL) return 0;
#endif
  errno = ret;
  return -1;
}
#endif

#define NAPI_MBT_EVENT_BUFFER_SIZE 1024
struct napi_mbt_event_waiter {
#ifdef _WIN32
  HANDLE thread_id;
  OVERLAPPED_ENTRY events[NAPI_MBT_EVENT_BUFFER_SIZE];
#else
  pthread_t thread_id;
  int cancel_pipe[2];
#endif
  HANDLE event_bus;
  void (*wakeup_cb)(void *);
  void *wakeup_ctx;
  atomic_int32_t cancelled;
  atomic_int32_t status;
  int32_t error;
  napi_mbt_wmutex_t lock;
  napi_mbt_wcond_t waker;
};

#ifdef _WIN32
static DWORD WINAPI napi_mbt_event_waiter_loop(void *data) {
#else
static void *napi_mbt_event_waiter_loop(void *data) {
#endif
  struct napi_mbt_event_waiter *waiter = (struct napi_mbt_event_waiter *)data;
  napi_mbt_wmutex_lock(&waiter->lock);
  while (!waiter->cancelled) {
#ifdef _WIN32
    ULONG n = 0;
    if (!GetQueuedCompletionStatusEx(waiter->event_bus, waiter->events, NAPI_MBT_EVENT_BUFFER_SIZE, &n, INFINITE, FALSE)) {
      waiter->error = (int32_t)GetLastError();
      waiter->status = -1;
      waiter->wakeup_cb(waiter->wakeup_ctx);
      break;
    }
    if (waiter->cancelled) break;
    if (n == 0) continue;
    waiter->status = (int32_t)n;
#else
    struct pollfd pfds[2] = {
      { waiter->event_bus, POLLIN, 0 },
      { waiter->cancel_pipe[0], POLLIN, 0 }
    };
    int ret = poll(pfds, 2, -1);
    if (ret < 0) {
      if (errno == EINTR) continue;
      waiter->error = errno;
      waiter->status = -1;
      waiter->wakeup_cb(waiter->wakeup_ctx);
      break;
    }
    if (waiter->cancelled) break;
    waiter->status = (pfds[0].revents & (POLLIN | POLLERR | POLLHUP)) ? 1 : 0;
    if (!waiter->status) continue;
#endif
    waiter->wakeup_cb(waiter->wakeup_ctx);
    while (waiter->status > 0 && !waiter->cancelled) {
      if (napi_mbt_wcond_wait(&waiter->waker, &waiter->lock) < 0) {
        waiter->error = (int32_t)GetLastError();
        goto exit;
      }
    }
  }
exit:
  napi_mbt_wmutex_unlock(&waiter->lock);
  return 0;
}

MOONBIT_FFI_EXPORT struct napi_mbt_event_waiter *napi_mbt_event_waiter_spawn(
  HANDLE bus, void (*wakeup_cb)(void *), void *wakeup_ctx
) {
  struct napi_mbt_event_waiter *waiter = calloc(1, sizeof(*waiter));
  if (!waiter) return NULL;
  waiter->event_bus = bus;
  waiter->wakeup_cb = wakeup_cb;
  waiter->wakeup_ctx = wakeup_ctx;
#ifndef _WIN32
  if (pipe(waiter->cancel_pipe) < 0) { free(waiter); return NULL; }
  for (int i = 0; i < 2; ++i) {
    int flags = fcntl(waiter->cancel_pipe[i], F_GETFD);
    if (flags < 0 || fcntl(waiter->cancel_pipe[i], F_SETFD, flags | FD_CLOEXEC) < 0) {
      close(waiter->cancel_pipe[0]); close(waiter->cancel_pipe[1]); free(waiter); return NULL;
    }
  }
#endif
  napi_mbt_wmutex_init(&waiter->lock);
  napi_mbt_wcond_init(&waiter->waker);
#ifdef _WIN32
  waiter->thread_id = CreateThread(NULL, 0, napi_mbt_event_waiter_loop, waiter, 0, NULL);
  if (!waiter->thread_id) {
    napi_mbt_wcond_destroy(&waiter->waker);
    napi_mbt_wmutex_destroy(&waiter->lock);
    free(waiter);
    return NULL;
  }
#else
  sigset_t curr_sigmask, all_signals;
  sigfillset(&all_signals);
  pthread_sigmask(SIG_SETMASK, &all_signals, &curr_sigmask);
  int rc = pthread_create(&waiter->thread_id, NULL, napi_mbt_event_waiter_loop, waiter);
  pthread_sigmask(SIG_SETMASK, &curr_sigmask, NULL);
  if (rc != 0) {
    napi_mbt_wcond_destroy(&waiter->waker);
    napi_mbt_wmutex_destroy(&waiter->lock);
    close(waiter->cancel_pipe[0]);
    close(waiter->cancel_pipe[1]);
    free(waiter);
    errno = rc;
    return NULL;
  }
#endif
  return waiter;
}

MOONBIT_FFI_EXPORT void napi_mbt_event_waiter_wake(struct napi_mbt_event_waiter *waiter) {
  waiter->status = 0;
  napi_mbt_wcond_signal(&waiter->waker);
  napi_mbt_wmutex_unlock(&waiter->lock);
}

MOONBIT_FFI_EXPORT int32_t napi_mbt_event_waiter_get_events(struct napi_mbt_event_waiter *waiter) {
  if (!waiter->status) return 0;
  napi_mbt_wmutex_lock(&waiter->lock);
  if (waiter->error) {
    int32_t err = waiter->error;
    napi_mbt_wmutex_unlock(&waiter->lock);
    SetLastError(err);
    return -1;
  }
#ifdef _WIN32
  return waiter->status;
#else
  int32_t ret = moonbitlang_async_event_bus_wait(waiter->event_bus, 0);
  if (ret <= 0) napi_mbt_event_waiter_wake(waiter);
  if (ret < 0 && errno == EINTR) ret = 0;
  return ret;
#endif
}

MOONBIT_FFI_EXPORT void *napi_mbt_event_waiter_get_event(struct napi_mbt_event_waiter *waiter, int32_t index) {
#ifdef _WIN32
  return &waiter->events[index];
#else
  return moonbitlang_async_event_list_get(waiter->event_bus, index);
#endif
}

MOONBIT_FFI_EXPORT void napi_mbt_event_waiter_terminate(struct napi_mbt_event_waiter *waiter) {
  if (!waiter) return;
  waiter->cancelled = 1;
  if (!waiter->status) {
#ifdef _WIN32
    PostQueuedCompletionStatus(waiter->event_bus, 0, 0, NULL);
#else
    int32_t zero = 0;
    while (write(waiter->cancel_pipe[1], &zero, sizeof(zero)) < 0 && errno == EINTR) {}
#endif
  }
  napi_mbt_wmutex_lock(&waiter->lock);
  napi_mbt_wcond_signal(&waiter->waker);
  napi_mbt_wmutex_unlock(&waiter->lock);
#ifdef _WIN32
  WaitForSingleObject(waiter->thread_id, INFINITE);
  CloseHandle(waiter->thread_id);
#else
  pthread_join(waiter->thread_id, NULL);
  close(waiter->cancel_pipe[0]);
  close(waiter->cancel_pipe[1]);
#endif
  napi_mbt_wmutex_destroy(&waiter->lock);
  napi_mbt_wcond_destroy(&waiter->waker);
  free(waiter);
}
