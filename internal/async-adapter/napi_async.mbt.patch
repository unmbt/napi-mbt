///|
priv struct NapiAsyncState {
  scheduler : @napi_mbt_async.Loop
  mut cancelled : Bool
}

///|
extern "c" fn napi_async_has(env : NapiEnv) -> Bool = "napi_mbt_async_has"

///|
extern "c" fn napi_async_get(env : NapiEnv) -> NapiAsyncState = "napi_mbt_async_get"

///|
#borrow(state)
extern "c" fn napi_async_attach(env : NapiEnv, state : NapiAsyncState, tick : FuncRef[(NapiAsyncState, Bool) -> Int32]) -> Int32 = "napi_mbt_async_attach"

///|
extern "c" fn napi_async_schedule(env : NapiEnv) -> Int32 = "napi_mbt_async_schedule"

///|
extern "c" fn napi_async_closing(env : NapiEnv) -> Bool = "napi_mbt_async_closing"

///|
extern "c" fn napi_current_env() -> NapiEnv = "napi_mbt_current_env"

///|
pub fn napi_async_spawn(task : async () -> Unit) -> @napi_mbt_async.Task raise {
  napi_async_submit(napi_current_env(), task)
}

///|
fn napi_async_tick(state : NapiAsyncState, closing : Bool) -> Int32 {
  try {
    if closing && !state.cancelled { state.cancelled = true; state.scheduler.cancel_all() }
    let pending = state.scheduler.step()
    if closing && pending == 0 { state.scheduler.close(); -2 } else { state.scheduler.next_wake() }
  } catch {
    error => { eprintln("napi-mbt async scheduler: \{error}"); 2 }
  }
}

///|
fn napi_async_submit(env : NapiEnv, task : async () -> Unit) -> @napi_mbt_async.Task raise {
  if napi_async_closing(env) { raise napi_failure(1004, Error, "ERR_NAPI_ENV_CLOSED", "Starting asynchronous task") }
  let state = if napi_async_has(env) { napi_async_get(env) } else {
    let state = { scheduler: @napi_mbt_async.Loop::new(), cancelled: false }
    errdefer { state.scheduler.close() catch { _ => () } }
    result_from_status(env, napi_async_attach(env, state, fn(state, closing) { napi_async_tick(state, closing) }), b"Attaching async scheduler")
    state
  }
  let handle = state.scheduler.submit(task)
  result_from_status(env, napi_async_schedule(env), b"Scheduling async task")
  handle
}

///|
priv struct NapiAsyncCall {
  env : NapiEnv
  promise : NapiAsyncPromise
  mut task : @napi_mbt_async.Task?
  mut signal : NapiReference?
  mut listener : NapiReference?
  pin : NapiReference
}

///|
// Node-API provides no release operation for an unsettled napi_deferred.
// Own JS resolver references instead so worker teardown can release them
// without entering JavaScript or settling a Promise in a closing environment.
priv struct NapiAsyncPromise {
  mut promise : NapiValue
  mut resolve : NapiCallback?
  mut reject : NapiCallback?
  mut accepting : Bool
  mut settled : Bool
}

///|
#borrow(result)
extern "c" fn napi_async_promise_create(env : NapiEnv, executor : NapiValue, result : Ref[NapiValue]) -> Int32 = "napi_mbt_async_promise_create"

///|
fn NapiAsyncPromise::dispose(self : NapiAsyncPromise) -> Unit {
  let resolve = self.resolve
  let reject = self.reject
  self.resolve = None
  self.reject = None
  self.accepting = false
  self.settled = true
  if resolve is Some(callback) { callback.dispose() catch { _ => () } }
  if reject is Some(callback) { callback.dispose() catch { _ => () } }
}

///|
fn napi_async_promise_new(env : NapiEnv) -> NapiAsyncPromise raise {
  let state : NapiAsyncPromise = { promise: moonbit_dummy_napi_value(), resolve: None, reject: None, accepting: true, settled: false }
  errdefer state.dispose()
  defer { state.accepting = false }
  let executor = napi_closure_new(env, fn(env, args) {
    try {
      if !state.accepting { raise napi_failure(1, TypeError, "ERR_NAPI_PROMISE_EXECUTOR", "Promise executor invoked outside construction") }
      state.accepting = false
      args.require(2)
      state.resolve = Some(NapiCallback::new(env, args.get(env, 0)))
      state.reject = Some(NapiCallback::new(env, args.get(env, 1)))
      set_Unit(env, ())
    } catch { error => { throw_napi_error(env, error); moonbit_dummy_napi_value() } }
  })
  let result = Ref(moonbit_dummy_napi_value())
  result_from_status(env, napi_async_promise_create(env, executor, result), b"Constructing async Promise")
  if state.resolve is None || state.reject is None { raise napi_failure(1, TypeError, "ERR_NAPI_PROMISE_EXECUTOR", "Promise constructor did not provide resolvers") }
  state.promise = result.val
  state
}

///|
fn NapiAsyncPromise::settle(self : NapiAsyncPromise, env : NapiEnv, value : NapiValue, reject~ : Bool) -> Unit raise {
  if self.settled { raise napi_failure(1, Error, "ERR_NAPI_PROMISE_SETTLED", "Promise has already settled") }
  self.settled = true
  defer self.dispose()
  guard (if reject { self.reject } else { self.resolve }) is Some(callback) else { raise napi_failure(1, Error, "ERR_NAPI_PROMISE_EXECUTOR", "Missing Promise resolver") }
  let args = napi_array_new(env, 1)
  napi_array_set(env, args, 0, value)
  ignore(callback.call(args))
}

///|
#borrow(name, result)
extern "c" fn napi_signal_get_raw(env : NapiEnv, object : NapiValue, name : Bytes, result : Ref[NapiValue]) -> Int32 = "napi_mbt_signal_get"

///|
extern "c" fn napi_signal_listen(env : NapiEnv, signal : NapiValue, listener : NapiValue, add : Bool) -> Int32 = "napi_mbt_signal_listen"

///|
#borrow(result)
extern "c" fn napi_abort_reason(env : NapiEnv, signal : NapiValue, result : Ref[NapiValue]) -> Int32 = "napi_mbt_abort_reason"

///|
#borrow(reference)
extern "c" fn napi_listener_pin(env : NapiEnv, listener : NapiValue, reference : NapiReference) -> Int32 = "napi_mbt_closure_pin"

///|
#borrow(reference)
extern "c" fn napi_listener_unpin(reference : NapiReference) -> Int32 = "napi_mbt_closure_unpin"

///|
fn napi_signal_get(env : NapiEnv, object : NapiValue, name : Bytes) -> NapiValue raise {
  let result = Ref(moonbit_dummy_napi_value())
  result_from_status(env, napi_signal_get_raw(env, object, name, result), b"Reading AbortSignal")
  result.val
}

///|
fn NapiAsyncCall::cleanup(self : NapiAsyncCall) -> Unit {
  self.promise.dispose()
  // Clear fields before invoking JS: removeEventListener may reenter the addon.
  let signal = self.signal
  let listener = self.listener
  self.signal = None
  self.listener = None
  self.task = None
  if !napi_async_closing(self.env) && signal is Some(signal) && listener is Some(listener) {
    try {
      result_from_status(self.env, napi_signal_listen(self.env, signal.get(self.env), listener.get(self.env), false), b"Removing abort listener")
    } catch { _ => () } // Preserve the original settlement; still release payload.
  }
  ignore(napi_listener_unpin(self.pin))
  if listener is Some(reference) { reference.dispose() catch { _ => () } }
  if signal is Some(reference) { reference.dispose() catch { _ => () } }
}

///|
fn NapiAsyncCall::reject(self : NapiAsyncCall, error : Error) -> Unit {
  if !self.promise.settled && !napi_async_closing(self.env) {
    try { self.promise.settle(self.env, napi_error_value(self.env, error), reject=true) }
    catch { error => { eprintln("napi-mbt: rejecting async call: " + (error : Error).to_string()) } }
  }
  self.cleanup()
}

///|
fn NapiAsyncCall::abort(self : NapiAsyncCall) -> Unit {
  if self.promise.settled { return }
  let task = self.task
  try {
    if self.signal is Some(signal) {
      let reason = Ref(moonbit_dummy_napi_value())
      result_from_status(self.env, napi_abort_reason(self.env, signal.get(self.env), reason), b"Reading abort reason")
      self.promise.settle(self.env, reason.val, reject=true)
    }
  } catch { error => self.reject(error) }
  if task is Some(task) {
    task.cancel() catch { error => { eprintln("napi-mbt: cancelling task: \{error}") } }
    ignore(napi_async_schedule(self.env))
  }
  self.cleanup()
}

///|
fn NapiAsyncCall::listen(self : NapiAsyncCall, options : NapiValue) -> Unit raise {
  if napi_is_nullish(self.env, options) { return }
  napi_require_object(self.env, options)
  let signal = napi_signal_get(self.env, options, b"signal")
  if napi_is_nullish(self.env, signal) { return }
  napi_require_object(self.env, signal)
  self.signal = Some(NapiReference::new(self.env, signal))
  if get_Bool(self.env, napi_signal_get(self.env, signal, b"aborted")) { self.abort(); return }
  let listener = napi_closure_new(self.env, (env, _) => { self.abort(); set_Unit(env, ()) catch { _ => moonbit_dummy_napi_value() } })
  self.listener = Some(NapiReference::new(self.env, listener))
  result_from_status(self.env, napi_listener_pin(self.env, listener, self.pin), b"Retaining abort listener")
  result_from_status(self.env, napi_signal_listen(self.env, signal, listener, true), b"Adding abort listener")
  if !self.promise.settled && get_Bool(self.env, napi_signal_get(self.env, signal, b"aborted")) { self.abort() }
}

///|
fn napi_async_call_new(env : NapiEnv) -> NapiAsyncCall raise {
  { env, promise: napi_async_promise_new(env), task: None, signal: None, listener: None, pin: napi_reference_empty() }
}

///|
fn NapiAsyncCall::start(self : NapiAsyncCall, work : async () -> NapiValue) -> Unit raise {
  if self.promise.settled { return }
  self.task = Some(napi_async_submit(self.env, () => {
    defer self.cleanup()
    if self.promise.settled || napi_async_closing(self.env) { return }
    try {
      let result = work()
      if !self.promise.settled && !napi_async_closing(self.env) { self.promise.settle(self.env, result, reject=false) }
    } catch { error => self.reject(error) }
  }))
}
