----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true)
  for name in @fs.readdir(source) {
    let src = source + "/" + name
    let dst = destination + "/" + name
    if @fs.kind(src) == Directory { copy_tree(src, dst) }
    else { @fs.write_binary(dst, @fs.read_binary(src)) }
  }
}

///|
async fn main {
  // Isolate compiler flags and caches; do not patch the developer's toolchain.
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-parser-asan-")
  defer @fs.remove(temp, recursive=true)
  @fs.write_text(temp + "/moon.mod", "name = \"unmbt/napi-mbt\"\npreferred_target = \"native\"\n")
  copy_tree(root + "/internal/syntax", temp + "/internal/syntax")
  copy_tree(root + "/generator", temp + "/generator")
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let flags = if windows { "/utf-8 /Z7 /fsanitize=address" } else { "-g -fsanitize=address -fno-omit-frame-pointer" }
  for pkg in ["internal/syntax", "generator"] {
    let path = temp + "/" + pkg + "/moon.pkg"
    let config = @fs.read_text(path)
    @fs.write_text(path, config.replace_all(old="options(", new="options(link: { \"native\": { \"cc-flags\": \"\{flags}\", \"stub-cc-flags\": \"\{flags}\" } }, "))
  }
  let env = {
    "MOONBIT_NEW_NATIVE": "0", "MOONBIT_ALLOCATOR": "system",
    "ASAN_OPTIONS": if windows { "detect_leaks=0:fast_unwind_on_malloc=0" } else { "detect_leaks=1:halt_on_error=1:fast_unwind_on_malloc=0" },
  }
  if windows {
    let pf = @env.get_env_var("ProgramFiles(x86)").unwrap_or("C:/Program Files (x86)")
    let _proc_res = @process.run(pf + "/Microsoft Visual Studio/Installer/vswhere.exe", ["-latest", "-products", "*", "-requires", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64", "-property", "installationPath", "-utf8"], stdout=Collect, stderr=Collect)
    let status = _proc_res.exit_code
    let out = _proc_res.stdout_text()
    let error = _proc_res.stderr_text()
    if status != 0 { fail(error) }
    let installation = out.trim().to_owned()
    let version = @fs.read_text(installation + "/VC/Auxiliary/Build/Microsoft.VCToolsVersion.default.txt").trim().to_owned()
    let directory = installation + "/VC/Tools/MSVC/" + version + "/bin/Hostx64/x64"
    assert_true(@fs.exists(directory + "/clang_rt.asan_dynamic-x86_64.dll"), msg="Missing ASan runtime for MSVC " + version)
    env["PATH"] = directory + ";" + @env.get_env_var("PATH").unwrap_or("")
  }
  let _proc_res = @process.run("moon", ["test", "--target", "native", "--release", "internal/syntax", "generator"], cwd=temp, extra_env=env, stdout=Collect, stderr=Collect)
  let code = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  println(out)
  println(err)
  if code != 0 { fail("Parser AddressSanitizer validation failed") }
}
