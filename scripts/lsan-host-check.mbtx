----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn main {
  guard @env.get_env_var("NAPI_MBT_TEST_NODE_PRELOAD") is Some(library) else { fail("Missing ASan preload") }
  let temp = @fs.tmpdir(prefix="napi-mbt-lsan-check-")
  defer @fs.remove(temp, recursive=true)
  @fs.write_text(temp + "/baseline.cjs", "const { Worker } = require('node:worker_threads');\nconst worker = new Worker('0', { eval: true });\nworker.on('error', error => { throw error; });\nworker.on('exit', code => { if (code) process.exitCode = code; else console.log('bare Node/worker ASan baseline'); });\n")
  let environment = { "LD_PRELOAD": library }
  let _proc_res = @async.with_timeout(30000, () => @process.run("node", [temp + "/baseline.cjs"], extra_env=environment, stdout=Collect, stderr=Collect))
  let status = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  if status != 0 { fail(out + err) }
  println(out)
  println(err)
  let source = temp + "/leak.c"
  let executable = temp + "/leak"
  @fs.write_text(source, "#include <stdlib.h>\n__attribute__((noinline)) void napi_mbt_leak_probe(void) { volatile char *p = malloc(37); p[0] = 1; }\nint main(void) { napi_mbt_leak_probe(); return 0; }\n")
  let code = @process.run("cc", ["-g", "-O0", "-fsanitize=address", "-fno-omit-frame-pointer", source, "-o", executable]).exit_code
  if code != 0 { fail("Cannot compile LeakSanitizer probe") }
  let _proc_res = @async.with_timeout(30000, () => @process.run(executable, [], extra_env=environment, stdout=Collect, stderr=Collect))
  let status = _proc_res.exit_code
  let err = _proc_res.stderr_text()
  assert_true(status != 0 && err.contains("37 byte(s) leaked") && err.contains("napi_mbt_leak_probe"), msg="Leak detection must remain active with host suppression: " + err)
  println("LeakSanitizer still detects unrelated allocations")
}
