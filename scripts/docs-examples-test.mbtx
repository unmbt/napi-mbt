----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn checked(program : String, args : Array[String]) -> Unit {
  let _proc_res = @async.with_timeout(180000, () => @process.run(program, args, stdout=Collect, stderr=Collect))
  let code = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  if code != 0 { fail(out + err) }
  println(out)
}

///|
async fn copy(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true)
  for name in @fs.readdir(source) {
    if name == "_build" { continue }
    if @fs.kind(source + "/" + name) == Directory { copy(source + "/" + name, destination + "/" + name) }
    else { @fs.write_binary(destination + "/" + name, @fs.read_binary(source + "/" + name)) }
  }
}

///|
async fn main {
  let binary = @fs.realpath(@env.args().get(1).unwrap_or("_build/native/release/build/cmd/napi-mbt-cli/napi-mbt-cli.exe"))
  let directory = @fs.tmpdir(prefix="napi-mbt-docs-")
  defer @fs.remove(directory, recursive=true)
  let dir = directory + "/fixture"
  checked(binary, ["init", dir, "--name", "documented-addon"])
  @fs.write_text(dir + "/moon.mod", "name = \"test/documented-addon\"\npreferred_target = \"native\"\nimport { \"moonbitlang/async@0.22.10\" }\n")
  @fs.write_text(dir + "/moon.pkg", @fs.read_text(dir + "/moon.pkg").replace_all(old="import {", new="import { \"moonbitlang/async\","))
  @fs.write_binary(dir + "/lib.mbt", @fs.read_binary("scripts/fixtures/documented-addon.mbt.txt"))
  @fs.write_text(dir + "/napi-mbt.json", "{\"napiVersion\":8}")
  if !@fs.exists(".repos/moonbitlang/async/0.22.10") && !@fs.exists(".mooncakes/moonbitlang/async") {
    checked("moon", ["fetch", "moonbitlang/async@0.22.10"])
  }
  copy((if @fs.exists(".repos/moonbitlang/async/0.22.10") { ".repos/moonbitlang/async/0.22.10" } else { ".mooncakes/moonbitlang/async" }), dir + "/.mooncakes/moonbitlang/async")
  checked(binary, ["build", dir, "--release"])
  let target = @fs.readdir(dir + "/artifacts")[0]
  checked("node", ["scripts/docs-examples.test.cjs", dir + "/artifacts/" + target + "/napi_mbt.node"])
  checked(binary, ["generate", dir, "--check"])
}
