----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn run(args : Array[String], environment : Map[String, String]) -> Unit {
  let code = @async.with_timeout(300000, () => @process.run("moon", args, extra_env=environment).exit_code)
  if code != 0 { fail("Sanitizer failed: " + args.join(" ")) }
}

///|
async fn main {
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let environment : Map[String, String] = {
    "ASAN_OPTIONS": if windows { "detect_leaks=0:halt_on_error=1" } else { "detect_leaks=1:halt_on_error=1" },
  }
  if windows {
    let pf = @env.get_env_var("ProgramFiles(x86)").unwrap_or("C:/Program Files (x86)")
    let _proc_res = @process.run(pf + "/Microsoft Visual Studio/Installer/vswhere.exe", ["-latest", "-products", "*", "-requires", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64", "-property", "installationPath", "-utf8"], stdout=Collect, stderr=Collect)
    let code = _proc_res.exit_code
    let out = _proc_res.stdout_text()
    let err = _proc_res.stderr_text()
    if code != 0 { fail(err) }
    let installation = out.trim().to_owned()
    let version = @fs.read_text(installation + "/VC/Auxiliary/Build/Microsoft.VCToolsVersion.default.txt").trim().to_owned()
    let directory = installation + "/VC/Tools/MSVC/" + version + "/bin/Hostx64/x64"
    assert_true(@fs.exists(directory + "/clang_rt.asan_dynamic-x86_64.dll"), msg="Missing ASan runtime for MSVC " + version)
    println("ASan runtime: " + directory)
    environment["PATH"] = directory + ";" + @env.get_env_var("PATH").unwrap_or("")
  } else {
    let _proc_res = @process.run("cc", ["-print-file-name=libasan.so"], stdout=Collect, stderr=Collect)
    let code = _proc_res.exit_code
    let out = _proc_res.stdout_text()
    let err = _proc_res.stderr_text()
    let mut library = out.trim().to_owned()
    if code != 0 || !@fs.exists(library) { fail("GCC ASan runtime unavailable: " + err) }
    // Some distributions return a linker script instead of a preloadable ELF.
    let bytes = @fs.read_binary(library)
    if bytes.length() < 4 || bytes[:4] != b"\x7fELF" {
      let text = @fs.read_text(library).trim()
      guard text.has_prefix("INPUT (") && text.has_suffix(")") else { fail("Unrecognized ASan linker script: " + library) }
      library = text[7:text.length() - 1].trim().to_owned()
      if !library.has_prefix("/") || !@fs.exists(library) { fail("Invalid ASan runtime path: " + library) }
      let resolved = @fs.read_binary(library)
      if resolved.length() < 4 || resolved[:4] != b"\x7fELF" { fail("ASan preload must be an ELF library") }
    }
    environment["NAPI_MBT_TEST_NODE_PRELOAD"] = library
    environment["LSAN_OPTIONS"] = "suppressions=" + @fs.realpath("scripts/lsan-node.supp") + ":print_suppressions=1"
    run(["run", "scripts/lsan-host-check.mbtx"], environment)
  }
  let binary = @env.args().get(1).unwrap_or("_build/native/release/build/cmd/napi-mbt-cli/napi-mbt-cli.exe")
  let fixtures = ["lock", "runtime-boundary", "structured-types", "collections", "owned-binary", "advanced-api", "tsfn", "native-tasks", "workers", "js-promises", "streams", "combined", "class", "callback", "async-exports"]
  let selected = if @env.args().contains("--fixture") {
    guard @env.args().last() is Some(name) && fixtures.contains(name) else { fail("Expected a known fixture after --fixture") }
    Some(name)
  } else { None }
  if selected is None { run(["run", "scripts/parser-asan-test.mbtx"], environment) }
  for fixture in fixtures {
    if selected is Some(name) && fixture != name { continue }
    run(["run", "scripts/" + fixture + "-test.mbtx", binary, "--asan"], environment)
    if fixture == "runtime-boundary" { run(["run", "scripts/test-runtime.mbtx", "--asan"], environment) }
    if fixture == "structured-types" { run(["run", "scripts/test-runtime.mbtx", "--structured", "--asan"], environment) }
  }
}
