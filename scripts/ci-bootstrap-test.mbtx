----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process" }
----

///|
async fn checked(args : Array[String], cwd : String) -> Unit {
  println("Clean checkout: moon " + args.join(" "))
  let code = @async.with_timeout(300000, () => @process.run("moon", args, cwd~).exit_code)
  if code != 0 { fail("Clean-checkout command failed: moon " + args.join(" ")) }
}

///|
async fn main {
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-ci-bootstrap-")
  let succeeded = Ref(false)
  defer {
    if succeeded.val { @fs.remove(temp, recursive=true) }
    else { eprintln("Clean checkout retained for diagnosis: " + temp) }
  }
  // Copy tracked sources, including local edits, but never cached dependencies,
  // generated binaries or downloaded reference repositories.
  let res = @process.run("git", ["ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root, stdout=Collect, stderr=Collect)
  if res.exit_code != 0 { fail(res.stderr_text()) }
  for name in res.stdout_text().split("\u0000") {
    if name.is_empty() { continue }
    let destination = temp + "/" + name.to_owned()
    let parts = name.split("/").to_array()
    if parts.length() > 1 {
      @fs.mkdir(temp + "/" + parts[:parts.length() - 1].join("/"), recursive=true, allow_existing=true)
    }
    @fs.write_binary(destination, @fs.read_binary(root + "/" + name.to_owned()))
  }
  assert_true(!@fs.exists(temp + "/.mooncakes"))
  assert_true(!@fs.exists(temp + "/_build"))
  assert_true(!@fs.exists(temp + "/.napi-mbt"))
  let pre_res = @process.run("moon", ["run", "scripts/sync-async-adapter.mbtx", "--check"], cwd=temp, stdout=Collect, stderr=Collect)
  assert_true(pre_res.exit_code != 0 && pre_res.stderr_text().contains("Missing moonbitlang/async@0.22.10 source"))
  checked(["check", "--target", "native", "--warn-list", "+73", "--deny-warn"], temp)
  checked(["run", "scripts/sync-runtime.mbtx", "--check"], temp)
  checked(["fetch", "moonbitlang/async@0.22.10"], temp)
  checked(["run", "scripts/sync-async-adapter.mbtx", "--check"], temp)
  succeeded.val = true
  println("Clean-checkout dependency bootstrap and template validation passed")
}
