----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn checked(binary : String, args : Array[String]) -> Unit {
  let _proc_res = @process.run(binary, args, stdout=Collect, stderr=Collect)
  let code = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  if code != 0 { fail(out + err) }
}

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true)
  for name in @fs.readdir(source) {
    if name == "_build" || name == ".git" { continue }
    if @fs.kind(source + "/" + name) == Directory { copy_tree(source + "/" + name, destination + "/" + name) }
    else { @fs.write_binary(destination + "/" + name, @fs.read_binary(source + "/" + name)) }
  }
}

///|
async fn main {
  let binary = @fs.realpath(@env.args().get(1).unwrap_or("_build/native/release/build/cmd/napi-mbt-cli/napi-mbt-cli.exe"))
  let temp = @fs.tmpdir(prefix="napi-mbt-minimum-")
  defer @fs.remove(temp, recursive=true)
  for mode in ["cjs", "dual", "async"] {
    let dir = temp + "/" + mode
    checked(binary, ["init", dir, "--name", "minimum-fixture"])
    @fs.write_text(dir + "/napi-mbt.json", ({ "napiVersion": if mode == "async" { 8 } else { 4 }, "esm": mode != "cjs" } : Json).stringify())
    if mode == "async" {
      @fs.write_text(dir + "/moon.mod", "name = \"minimum-fixture\"\npreferred_target = \"native\"\nimport { \"moonbitlang/async@0.22.10\" }\n")
      @fs.write_text(dir + "/moon.pkg", @fs.read_text(dir + "/moon.pkg").replace_all(old="import {", new="import { \"moonbitlang/async\","))
      @fs.write_text(dir + "/lib.mbt", @fs.read_text(dir + "/lib.mbt") + "\n///|\n#export_name(\"delay\")\npub async fn delay(ms : Int, value : String) -> String { @async.sleep(ms); value }\n")
      if !@fs.exists(".repos/moonbitlang/async/0.22.10") && !@fs.exists(".mooncakes/moonbitlang/async") {
        checked("moon", ["fetch", "moonbitlang/async@0.22.10"])
      }
      copy_tree((if @fs.exists(".repos/moonbitlang/async/0.22.10") { ".repos/moonbitlang/async/0.22.10" } else { ".mooncakes/moonbitlang/async" }), dir + "/.mooncakes/moonbitlang/async")
    }
    checked(binary, ["build", dir, "--release"])
    let out = ".napi-mbt/minimum-" + mode
    if !@fs.exists(out) { @fs.mkdir(out, recursive=true) }
    for name in ["index.cjs", "index.mjs", "package.json"] { if @fs.exists(dir + "/" + name) { @fs.write_binary(out + "/" + name, @fs.read_binary(dir + "/" + name)) } }
    if @fs.exists(out + "/artifacts") { @fs.remove(out + "/artifacts", recursive=true) }
    copy_tree(dir + "/artifacts", out + "/artifacts")
    checked("node", ["scripts/minimum-node.test.cjs", mode])
  }
}
