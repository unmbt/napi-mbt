import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/process" }

///|
async fn main {
  let (status, out, err) = @process.collect_output("moon", ["-V"])
  if status != 0 { fail(err.text()) }
  let report = out.text()
  for expected in [
    "moon 0.1.20261104 (940aa18 2026-11-04)",
    "moonc v0.10.20+65efd5b93 (2026-11-05)",
    "moonrun 0.1.20261104 (940aa18 2026-11-04)",
    "Feature flags enabled: rr_moon_mod,rr_moon_pkg",
  ] {
    if !report.contains(expected) { fail("Pinned toolchain mismatch; expected " + expected + "\n" + report) }
  }
  println(report)
}
