----
import { "moonbitlang/core/async", "moonbitlang/core/async/process" }
----

///|
async fn main {
  let res = @process.run("moon", ["-V"], stdout=Collect, stderr=Collect)
  if res.exit_code != 0 { fail(res.stderr_text()) }
  let report = res.stdout_text()
  for expected in [
    "moon 0.1.20261119 (738607b 2026-11-19)",
    "moonc v0.10.22+124d61d05 (2026-11-19)",
    "moonrun 0.1.20261119 (738607b 2026-11-19)",
  ] {
    if !report.contains(expected) { fail("Pinned toolchain mismatch; expected " + expected + "\n" + report) }
  }
  println(report)
}
