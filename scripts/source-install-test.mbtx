import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/process", "moonbitlang/core/env" }

///|
async fn pnpm_command() -> (String, Array[String]) {
  if @env.get_env_var("OS") != Some("Windows_NT") { return ("pnpm", []) }
  for dir in @env.get_env_var("PATH").unwrap_or("").split(";") {
    let cli = dir.to_owned() + "/node_modules/pnpm/bin/pnpm.cjs"
    if @fs.exists(cli) { return ("node", [cli]) }
  }
  fail("Cannot find pnpm.cjs beside Node on PATH")
}

///|
async fn main {
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-source-install-")
  defer @fs.rmdir(temp, recursive=true)
  // Only tracked manifests: no generated npm/, artifacts/ or node_modules/.
  for name in ["package.json", "pnpm-lock.yaml", "moon.mod"] {
    @fs.write_file(temp + "/" + name, @fs.read_file(root + "/" + name))
  }
  let (program, prefix) = pnpm_command()
  let (code, out, err) = @async.with_timeout(
    180000,
    () => @process.collect_output(program, prefix + ["install", "--frozen-lockfile", "--ignore-scripts"], cwd=temp),
  )
  if code != 0 { fail(out.text() + err.text()) }
  assert_true(@fs.exists(temp + "/node_modules/typescript/bin/tsc"))
  assert_eq(@fs.read_file(temp + "/pnpm-lock.yaml").binary(), @fs.read_file(root + "/pnpm-lock.yaml").binary())
  let command = ["run", root + "/scripts/release-check.mbtx"]
  assert_eq(@process.run("moon", command, cwd=temp), 0)
  // A missing lockfile importer must fail before a frozen pnpm install runs.
  let lock = @fs.read_file(temp + "/pnpm-lock.yaml").text()
  @fs.write_file(temp + "/pnpm-lock.yaml", lock.replace_all(old="\n  .:\n", new="\n  missing:\n"))
  let (code, out, err) = @process.collect_output(program, prefix + ["install", "--frozen-lockfile", "--ignore-scripts"], cwd=temp)
  let message = out.text() + err.text()
  assert_true(code != 0 && (message.contains("frozen") || message.contains("outdated") || message.contains("importer") || message.contains("lockfile")))
  println("Clean source installation and incomplete-lockfile rejection passed")
}
