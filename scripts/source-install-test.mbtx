import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/process", "moonbitlang/core/env", "moonbitlang/core/json" }

///|
async fn main {
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-source-install-")
  defer @fs.rmdir(temp, recursive=true)
  // Only tracked manifests: no generated npm/, artifacts/ or node_modules/.
  for name in ["package.json", "package-lock.json", "moon.mod"] {
    @fs.write_file(temp + "/" + name, @fs.read_file(root + "/" + name))
  }
  let mut program = "npm"
  let args = ["ci", "--ignore-scripts", "--no-audit", "--no-fund"]
  if @env.get_env_var("OS") == Some("Windows_NT") {
    program = "node"
    let mut cli : String? = None
    for directory in @env.get_env_var("PATH").unwrap_or("").split(";") {
      let path = directory.to_owned() + "/node_modules/npm/bin/npm-cli.js"
      if @fs.exists(path) { cli = Some(path); break }
    }
    guard cli is Some(path) else { fail("npm-cli.js not found") }
    args.insert(0, path)
  }
  let (code, out, err) = @async.with_timeout(180000, () => @process.collect_output(program, args, cwd=temp))
  if code != 0 { fail(out.text() + err.text()) }
  assert_true(@fs.exists(temp + "/node_modules/typescript/bin/tsc"))
  assert_eq(@fs.read_file(temp + "/package-lock.json").binary(), @fs.read_file(root + "/package-lock.json").binary())
  let command = ["run", root + "/scripts/release-check.mbtx"]
  assert_eq(@process.run("moon", command, cwd=temp), 0)
  // A missing lock entry must fail before an npm CI job encounters it.
  guard @json.parse(@fs.read_file(temp + "/package-lock.json").text()) is Object(lock) else { fail("Invalid lock") }
  guard lock.get("packages") is Some(Object(packages)) else { fail("Missing packages") }
  packages.remove("node_modules/typescript")
  @fs.write_file(temp + "/package-lock.json", Json(lock).stringify(indent=2))
  let (code, _, err) = @process.collect_output("moon", command, cwd=temp)
  assert_true(code != 0 && err.text().contains("Missing lockfile package: typescript"))
  println("Clean source installation and incomplete-lockfile rejection passed")
}
