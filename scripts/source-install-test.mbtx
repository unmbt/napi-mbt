----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn pnpm_command() -> (String, Array[String]) {
  if @env.get_env_var("OS") != Some("Windows_NT") { return ("pnpm", []) }
  for dir in @env.get_env_var("PATH").unwrap_or("").split(";") {
    for base in [dir.to_owned() + "/node_modules/pnpm/bin", dir.to_owned() + "/../pnpm/bin"] {
      for name in ["pnpm.mjs", "pnpm.cjs"] {
        let cli = base + "/" + name
        if @fs.exists(cli) { return ("node", [cli]) }
      }
    }
  }
  fail("Cannot find pnpm launcher beside Node on PATH")
}

///|
async fn main {
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-source-install-")
  defer @fs.remove(temp, recursive=true)
  // Only tracked manifests: no generated npm/, artifacts/ or node_modules/.
  for name in ["package.json", "pnpm-lock.yaml", "moon.mod"] {
    @fs.write_binary(temp + "/" + name, @fs.read_binary(root + "/" + name))
  }
  let (program, prefix) = pnpm_command()
  let _res = @async.with_timeout(
    180000,
    () => @process.run(program, prefix + ["install", "--frozen-lockfile", "--ignore-scripts"], cwd=temp, stdout=Collect, stderr=Collect),
  )
  if _res.exit_code != 0 { fail(_res.stdout_text() + _res.stderr_text()) }
  assert_true(@fs.exists(temp + "/node_modules/typescript/bin/tsc"))
  assert_eq(@fs.read_binary(temp + "/pnpm-lock.yaml"), @fs.read_binary(root + "/pnpm-lock.yaml"))
  let command = ["run", root + "/scripts/release-check.mbtx"]
  assert_eq(@process.run("moon", command, cwd=temp).exit_code, 0)
  // A mismatched importer must fail before a frozen pnpm install runs.
  let lock = @fs.read_text(temp + "/pnpm-lock.yaml")
  let mismatch = "\n        specifier: 26.1.2"
  assert_true(lock.contains(mismatch), msg="Fixture lockfile lost its importer")
  @fs.write_text(temp + "/pnpm-lock.yaml", lock.replace_all(old=mismatch, new="\n        specifier: 0.0.0"))
  let _proc_res = @process.run(program, prefix + ["install", "--frozen-lockfile", "--ignore-scripts"], cwd=temp, stdout=Collect, stderr=Collect)
  let code = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  let message = out + err
  assert_true(code != 0, msg=message)
  println("Clean source installation and incomplete-lockfile rejection passed")
}
