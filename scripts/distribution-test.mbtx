import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/process", "moonbitlang/core/env", "moonbitlang/core/json" }

///|
async fn checked(program : String, args : Array[String], cwd? : StringView) -> String {
  let (code, out, err) = @async.with_timeout(120000, () => @process.collect_output(program, args, cwd?))
  if code != 0 { fail(out.text() + err.text()) }
  out.text()
}

///|
async fn pnpm(args : Array[String], cwd : String) -> String {
  if @env.get_env_var("OS") != Some("Windows_NT") {
    return checked("pnpm", args, cwd~)
  }
  for dir in @env.get_env_var("PATH").unwrap_or("").split(";") {
    for base in [dir.to_owned() + "/node_modules/pnpm/bin", dir.to_owned() + "/../pnpm/bin"] {
      for name in ["pnpm.mjs", "pnpm.cjs"] {
        let cli = base + "/" + name
        if @fs.exists(cli) { return checked("node", [cli] + args, cwd~) }
      }
    }
  }
  fail("Cannot find pnpm launcher beside Node on PATH")
}

///|
async fn rejected(binary : String, dir : String, target : String) -> Unit {
  let (code, _, _) = @process.collect_output(binary, ["prepublish", dir, "--target", target])
  assert_true(code != 0)
}

///|
async fn main {
  let binary = @fs.realpath(@env.args().get(1).unwrap_or("_build/native/release/build/cmd/napi-mbt-cli/napi-mbt-cli.exe"))
  let root = @fs.realpath(".")
  let temp = @fs.tmpdir(prefix="napi-mbt-distribution-")
  defer @fs.rmdir(temp, recursive=true)
  assert_true(!@env.args().contains("--root"), msg="napi-mbt is distributed through Mooncakes; this test packages a generated addon")
  let dir = temp + "/package with spaces"
  ignore(checked(binary, ["init", dir, "--name", "distribution-fixture"]))
  ignore(checked(binary, ["build", dir, "--release"]))
  let target = @fs.readdir(dir + "/artifacts")[0]
  let artifact = dir + "/artifacts/" + target + "/napi_mbt.node"
  let binary_data = @fs.read_file(artifact).binary()
  @fs.write_file(artifact, "broken")
  rejected(binary, dir, target)
  @fs.write_file(artifact, binary_data)
  let declarations = @fs.read_file(dir + "/index.d.ts").text()
  @fs.write_file(dir + "/index.d.ts", declarations + "// stale\n")
  rejected(binary, dir, target)
  @fs.write_file(dir + "/index.d.ts", declarations)
  let mod = @fs.read_file(dir + "/moon.mod").text()
  @fs.write_file(dir + "/moon.mod", mod + "\nversion = \"999.0.0\"\n")
  rejected(binary, dir, target)
  @fs.write_file(dir + "/moon.mod", mod)
  ignore(checked(binary, ["prepublish", dir, "--target", target]))
  let tarballs = []
  for package_dir in [dir + "/npm/" + target, dir] {
    let dry = pnpm(["pack", "--dry-run", "--json"], package_dir)
    guard @json.parse(dry) is { "files": Array(files), .. } else { fail("Invalid pnpm pack result") }
    for license in ["napi-mbt.txt", "node-api.txt", "moonbit-async.txt", "libuv.txt"] {
      assert_true(files.any(file => match file { { "path": String(path), .. } => path == "licenses/" + license; _ => false }), msg="Missing bundled license: " + license)
    }
    assert_true(files.all(file => match file { { "path": String(path), .. } => !path.has_prefix(".napi-mbt/") && !path.has_suffix(".mbt") && !path.has_suffix(".c"); _ => false }))
    let packed = pnpm(["pack", "--json", "--pack-destination", temp], package_dir)
    guard @json.parse(packed) is { "filename": String(filename), .. } else { fail("Invalid pnpm pack result") }
    tarballs.push(filename)
  }
  let consumer = temp + "/clean consumer"
  @fs.mkdir(consumer)
  @fs.write_file(consumer + "/package.json", "{\"name\":\"consumer\",\"private\":true}")
  ignore(pnpm(["add", "--offline", "--ignore-scripts", "--save-prod"] + tarballs, consumer))
  let package_name = "distribution-fixture"
  let function_name = "mbt_add"
  ignore(checked("node", [root + "/scripts/distribution.test.cjs", consumer, package_name, function_name]))
  @fs.write_file(consumer + "/check.mts", "import addon, { \{function_name} } from '\{package_name}';\nconst result: number = addon.\{function_name}(1, 2) + \{function_name}(3, 4);\n// @ts-expect-error invalid input\n\{function_name}('1', 2);\n")
  ignore(checked("node", [root + "/node_modules/typescript/bin/tsc", "--noEmit", "--strict", "--types", "node", "--typeRoots", root + "/node_modules/@types", "--module", "NodeNext", "--moduleResolution", "NodeNext", consumer + "/check.mts"]))
  println("Release gates, pnpm pack/dry-run, offline clean installation, CJS/ESM and installed declarations passed")
}
