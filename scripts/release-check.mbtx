///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let write = @env.args().contains("--write")
  guard @json.parse(@fs.read_file("package.json").text()) is Object(manifest) else {
    fail("Invalid package manifest")
  }
  assert_eq(manifest.get("private"), Some(Json(true)), msg="The root npm package is for development only")
  assert_eq(manifest.get("publishConfig"), None)
  guard manifest.get("engines") is Some(Object(engines)) else {
    fail("The root manifest must declare pnpm support")
  }
  assert_eq(engines.get("pnpm"), Some(Json(">=10")))
  let mut module_version : String? = None
  for line in @fs.read_file("moon.mod").text().split("\n") {
    let line = line.trim()
    if line.has_prefix("version = ") {
      guard module_version is None else { fail("Duplicate version in moon.mod") }
      guard @json.parse(line[10:].trim().to_owned()) is String(value) else {
        fail("Invalid module version")
      }
      module_version = Some(value)
    }
  }
  guard module_version is Some(release_version) else {
    fail("Missing Mooncakes release version")
  }
  if @env.get_env_var("GITHUB_REF_TYPE") == Some("tag") &&
    @env.get_env_var("GITHUB_REF_NAME") is Some(tag) {
    assert_eq(tag, "v" + release_version, msg="Release tag must match moon.mod")
  }
  let path = "pnpm-lock.yaml"
  let original = @fs.read_file(path).text()
  let normalized = original.replace_all(old="\r\n", new="\n")
  let canonical = normalized.replace_all(
    old="https://mirrors.tencent.com/npm/",
    new="https://registry.npmjs.org/",
  )
  if write {
    @fs.write_file(path, canonical)
  } else {
    assert_eq(normalized, canonical, msg="pnpm lockfile must use the public npm registry")
  }
  assert_true(canonical.contains("lockfileVersion:"), msg="Invalid pnpm lockfile")
  assert_true(canonical.contains("\nimporters:\n"), msg="Missing pnpm lockfile importers")
  assert_true(canonical.contains("\n  .:\n"), msg="Missing root pnpm importer")
  println("Mooncakes release version and pnpm development lockfile checks passed")
}
