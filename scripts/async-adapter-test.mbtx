----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/json", "moonbitlang/core/env" }
----

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true)
  for name in @fs.readdir(source) {
    if name == "_build" || name == ".git" { continue }
    if @fs.kind(source + "/" + name) == Directory { copy_tree(source + "/" + name, destination + "/" + name) }
    else { @fs.write_binary(destination + "/" + name, @fs.read_binary(source + "/" + name)) }
  }
}

///|
async fn main {
  let temp = @fs.tmpdir(prefix="napi-mbt-async-adapter-")
  defer @fs.remove(temp, recursive=true)
  @fs.write_text(temp + "/moon.mod", "name = \"test/async-adapter\"\npreferred_target = \"native\"\nimport { \"moonbitlang/async@0.22.10\" }\n")
  @fs.write_text(temp + "/moon.pkg", "import { \"moonbitlang/async/napi_host\", \"moonbitlang/async\", \"moonbitlang/core/env\" }\n")
  if !@fs.exists(".repos/moonbitlang/async/0.22.10") && !@fs.exists(".mooncakes/moonbitlang/async") {
    let _fetch_res = @process.run("moon", ["fetch", "moonbitlang/async@0.22.10"], stdout=Collect, stderr=Collect)
    if _fetch_res.exit_code != 0 { fail(_fetch_res.stdout_text() + _fetch_res.stderr_text()) }
  }
  copy_tree((if @fs.exists(".repos/moonbitlang/async/0.22.10") { ".repos/moonbitlang/async/0.22.10" } else { ".mooncakes/moonbitlang/async" }), temp + "/.mooncakes/moonbitlang/async")
  guard @json.parse(@fs.read_text("internal/assets/data/resources.json")) is Object(resources) else { fail("Invalid resources") }
  for key, value in resources {
    if key.has_prefix("async/files/") {
      guard value is String(text) else { fail("Invalid resource") }
      if !@fs.exists(temp + "/.mooncakes/moonbitlang/async/src/napi_host") { @fs.mkdir(temp + "/.mooncakes/moonbitlang/async/src/napi_host", recursive=true) }
      @fs.write_text(temp + "/.mooncakes/moonbitlang/async/" + key[12:].to_owned(), text)
    }
  }
  let event_package = temp + "/.mooncakes/moonbitlang/async/src/internal/event_loop/moon.pkg"
  @fs.write_text(event_package, @fs.read_text(event_package).replace_all(old="\"moonbitlang/core/deque\",", new="\"moonbitlang/core/deque\", \"moonbitlang/async/io\","))
  if @env.args() is [_, "--posix", distro, include_dir] {
    let _proc_res = @process.run("wsl.exe", ["-d", distro, "--", "wslpath", "-u", temp.replace_all(old="\\", new="/")], stdout=Collect, stderr=Collect)
    let code = _proc_res.exit_code
    let path = _proc_res.stdout_text()
    let err = _proc_res.stderr_text()
    if code != 0 { fail(err) }
    let _proc_res = @process.run("wsl.exe", ["-d", distro, "--", "wslpath", "-u", include_dir.replace_all(old="\\", new="/")], stdout=Collect, stderr=Collect)
    let code = _proc_res.exit_code
    let include_path = _proc_res.stdout_text()
    let err = _proc_res.stderr_text()
    if code != 0 { fail(err) }
    let _proc_res = @process.run("wsl.exe", ["-d", distro, "--", "cc", "-std=c11", "-D_GNU_SOURCE", "-fsyntax-only", "-I" + include_path.trim().to_owned(), path.trim().to_owned() + "/.mooncakes/moonbitlang/async/src/internal/event_loop/thread_pool.c"], stdout=Collect, stderr=Collect)
    let status = _proc_res.exit_code
    let out = _proc_res.stdout_text()
    let err = _proc_res.stderr_text()
    if status != 0 { fail(out + err) }
    println("POSIX thread-pool C syntax check passed (not a runtime test)")
    return
  }
  let source =
    #|///|
    #|test "host steps independent async environments" {
    #|  let a = @napi_host.Loop::new()
    #|  let b = @napi_host.Loop::new()
    #|  let results = Ref(0)
    #|  ignore(a.submit(() => { @async.sleep(10); results.val += 1 }))
    #|  ignore(b.submit(() => { @async.sleep(20); results.val += 10 }))
    #|  let begin = @env.now()
    #|  while results.val != 11 {
    #|    ignore(a.step())
    #|    ignore(b.step())
    #|    if @env.now() - begin > 2000UL { fail("Timed out") }
    #|  }
    #|  assert_eq(a.next_wake(), -1)
    #|  a.close(); b.close()
    #|}
    #|///|
    #|test "host cancellation drains before shutdown" {
    #|  let evloop = @napi_host.Loop::new()
    #|  let cleaned = Ref(false)
    #|  ignore(evloop.submit(() => { defer { cleaned.val = true }; @async.sleep(10000) }))
    #|  ignore(evloop.step())
    #|  evloop.cancel_all()
    #|  ignore(evloop.step())
    #|  assert_true(cleaned.val)
    #|  evloop.close(); evloop.close()
    #|}
    #|
  @fs.write_text(temp + "/adapter_test.mbt", source)
  let _proc_res = @async.with_timeout(120000, () => @process.run("moon", ["test", "--target", "native", "--release"], cwd=temp, extra_env={ "MOONBIT_NEW_NATIVE": "0", "MOONBIT_ALLOCATOR": "system" }, stdout=Collect, stderr=Collect))
  let code = _proc_res.exit_code
  let out = _proc_res.stdout_text()
  let err = _proc_res.stderr_text()
  println(out)
  if code != 0 { fail(err) }
}
