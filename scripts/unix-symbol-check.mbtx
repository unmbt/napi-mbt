----
import { "moonbitlang/core/async", "moonbitlang/core/async/fs", "moonbitlang/core/async/process", "moonbitlang/core/env" }
----

///|
async fn main {
  if @env.get_env_var("OS") == Some("Windows_NT") {
    println("Unix libc symbol collision check skipped on Windows")
    return
  }
  let root = @fs.realpath(".")
  let binary = @fs.realpath(
    @env.args().get(1).unwrap_or("_build/native/release/build/cmd/napi-mbt-cli/napi-mbt-cli.exe"),
  )
  let temp = @fs.tmpdir(prefix="napi-mbt-unix-symbol-")
  defer @fs.remove(temp, recursive=true)
  let project = temp + "/fixture"
  let _proc_res = @process.run(binary,
    ["init", project, "--name", "unix-symbol-fixture"],
    cwd=root, stdout=Collect, stderr=Collect)
  let init_code = _proc_res.exit_code
  let init_out = _proc_res.stdout_text()
  let init_err = _proc_res.stderr_text()
  if init_code != 0 {
    fail(init_out + init_err)
  }
  let source = @fs.read_text(project + "/lib.mbt")
    .replace_all(old="mbt_add", new="read") +
    "\n///|\n#export_name(\"write\")\npub fn write(value : Int) -> Int { value }\n"
  @fs.write_text(project + "/lib.mbt", source)
  // JavaScript names are adapter-prefixed native symbols and may legally use
  // libc words. The actual native-link export list is the collision boundary.
  let js_res = @async.with_timeout(180000, () => {
    @process.run(binary, ["build", project, "--release"], cwd=root, stdout=Collect, stderr=Collect)
  })
  assert_eq(js_res.exit_code, 0, msg=js_res.stdout_text() + js_res.stderr_text())
  let raw_pkg = @fs.read_text(project + "/moon.pkg")
  let package_text = raw_pkg
    .replace_all(
      old="\"exports\": [ ],",
      new="\"exports\": [\"read\", \"write\"],",
    )
    .replace_all(
      old="\"exports\": [],",
      new="\"exports\": [\"read\", \"write\"],",
    )
  if package_text == raw_pkg {
    fail("Failed to inject exports into moon.pkg")
  }
  @fs.write_text(project + "/moon.pkg", package_text)
  let res = @async.with_timeout(180000, () => {
    @process.run(binary, ["build", project, "--release"], cwd=root, stdout=Collect, stderr=Collect)
  })
  let output = res.stdout_text() + res.stderr_text()
  assert_true(res.exit_code != 0, msg="A libc symbol collision must fail the Unix build")
  assert_true(
    output.contains("Unix libc symbol collision") &&
    output.contains("read") && output.contains("write"),
    msg=output,
  )
  println("Native libc symbol collisions are rejected; JS names remain adapter-scoped")
}
