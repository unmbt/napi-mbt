----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  if !@fs.exists(destination) { @fs.mkdir(destination, recursive=true) }
  for name in @fs.readdir(source) {
    let src = source + "/" + name
    let dst = destination + "/" + name
    if @fs.kind(src) == Directory {
      copy_tree(src, dst)
    } else {
      @fs.write_binary(dst, @fs.read_binary(src))
    }
  }
}

///|
async fn main {
  guard @env.args() is [_, runtime, grammar, headers] else {
    fail("Usage: vendor-native.mbtx <tree-sitter-0.26.8> <grammar-190881d> <node-api-headers-1.9.0>")
  }
  let dest = "internal/syntax/vendor"
  copy_tree(runtime + "/lib/src", dest + "/runtime")
  for name in ["utf8.h", "utf16.h", "umachine.h"] {
    let path = dest + "/runtime/unicode/" + name
    @fs.write_text(path, @fs.read_text(path).replace_all(old="\"unicode/", new="\""))
  }
  copy_tree(runtime + "/lib/include/tree_sitter", dest + "/runtime/tree_sitter")
  copy_tree(grammar + "/src", dest + "/grammar")
  @fs.write_binary(dest + "/TREE-SITTER-LICENSE", @fs.read_binary(runtime + "/LICENSE"))
  @fs.write_binary(dest + "/GRAMMAR-LICENSE", @fs.read_binary(grammar + "/LICENSE"))
  if !@fs.exists("internal/assets/data") { @fs.mkdir("internal/assets/data", recursive=true) }
  guard @json.parse(@fs.read_text("internal/assets/data/resources.json")) is Object(resources) else { fail("Invalid resources.json") }
  for name in ["node_api.h", "node_api_types.h", "js_native_api.h", "js_native_api_types.h"] {
    resources["include/" + name] = Json(@fs.read_text(headers + "/include/" + name))
  }
  resources["node_api.def"] = Json(@fs.read_text(headers + "/def/node_api.def"))
  resources["NODE-API-LICENSE"] = Json(@fs.read_text(headers + "/LICENSE"))
  @fs.write_text("internal/assets/data/resources.json", Json(resources).stringify(indent=2) + "\n")
}
