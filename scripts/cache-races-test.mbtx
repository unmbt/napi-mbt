import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/process", "moonbitlang/core/env" }

///|
async fn checked(binary : String, args : Array[String]) -> Unit {
  let (code, out, err) = @async.with_timeout(180000, () => @process.collect_output(binary, args))
  if code != 0 { fail(out.text() + err.text()) }
}

///|
async fn started(log : String) -> Unit {
  @async.with_timeout(30000, () => {
    while !@fs.read_file(log).text().contains("[napi-mbt] command") { @async.sleep(20) }
  })
}

///|
async fn main {
  let binary = @fs.realpath(@env.args().get(1).unwrap_or("_build/native/debug/build/cmd/napi-mbt-cli/napi-mbt-cli.exe"))
  let temp = @fs.tmpdir(prefix="napi-mbt-cache-races-")
  defer @fs.rmdir(temp, recursive=true)
  let dir = temp + "/project"
  checked(binary, ["init", dir])
  checked(binary, ["build", dir, "--release"])
  let target = @fs.readdir(dir + "/artifacts")[0]
  let artifact = dir + "/artifacts/" + target + "/napi_mbt.node"
  let previous = @fs.read_file(artifact).binary()
  let declaration = @fs.read_file(dir + "/index.d.ts").binary()
  let source = @fs.read_file(dir + "/lib.mbt").text()
  let log = temp + "/race.log"
  let output = @process.redirect_to_file(log, shared=true)
  @async.with_task_group(group => {
    let child = @process.spawn(group, binary, ["build", dir, "--release", "--no-cache", "--verbose"], stdout=output, stderr=output, cancel_handler=@process.hard_cancel())
    defer child.cancel()
    started(log)
    @fs.write_file(dir + "/lib.mbt", source + "\n// modified while toolchain probe is running\n")
    assert_true(child.wait() != 0)
  })
  output.close()
  assert_true(@fs.read_file(log).text().contains("inputs changed during build"))
  assert_eq(@fs.read_file(artifact).binary(), previous)
  assert_eq(@fs.read_file(dir + "/index.d.ts").binary(), declaration)
  @fs.write_file(dir + "/lib.mbt", source)
  checked(binary, ["build", dir, "--release"])
  let killed_log = temp + "/killed.log"
  let killed_output = @process.redirect_to_file(killed_log, shared=true)
  @async.with_task_group(group => {
    let child = @process.spawn(group, binary, ["build", dir, "--release", "--no-cache", "--verbose"], stdout=killed_output, stderr=killed_output, cancel_handler=@process.hard_cancel())
    started(killed_log)
    child.cancel()
    ignore(child.wait())
  })
  killed_output.close()
  // If a crashed process left a userspace lock, this command would time out.
  checked(binary, ["build", dir, "--release"])
  @fs.mkdir(temp + "/neighbor")
  @fs.write_file(temp + "/neighbor/sentinel", "keep")
  @async.with_task_group(group => {
    let build = group.spawn(() => checked(binary, ["build", dir, "--release"]))
    let clean = group.spawn(() => checked(binary, ["clean", dir, "--cache"]))
    build.wait(); clean.wait()
  })
  assert_eq(@fs.read_file(temp + "/neighbor/sentinel").text(), "keep")
  checked(binary, ["build", dir, "--release"])
  checked(binary, ["prepublish", dir, "--target", target])
  println("Input races preserve artifacts; process exit unlocks; clean/build serialize")
}
