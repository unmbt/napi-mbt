///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let args = @env.args()
  guard args is [_, input, output] else {
    fail("Usage: moon run scripts/gen_version.mbtx <moon.mod> <output.mbt>")
  }
  let content = @fs.read_file(input).text()
  let mut version : String? = None
  for line in content.split("\n") {
    let line = line.trim()
    if line.has_prefix("//") {
      continue
    }
    guard line.find("=") is Some(index) else { continue }
    if line[:index].trim() != "version" {
      continue
    }
    if version is Some(_) {
      fail("Duplicate version in moon.mod")
    }
    guard @json.parse(line[index + 1:].trim().to_owned()) is String(value) else {
      fail("moon.mod version must be a string")
    }
    if value.is_empty() ||
      !value
      .iter()
      .all(c => {
        (c >= '0' && c <= '9') ||
        (c >= 'a' && c <= 'z') ||
        (c >= 'A' && c <= 'Z') ||
        c == '.' ||
        c == '-' ||
        c == '+'
      }) {
      fail("Invalid version in moon.mod")
    }
    version = Some(value)
  }
  guard version is Some(value) else { fail("Missing version in moon.mod") }
  @fs.write_file(
    output,
    "// Generated by scripts/gen_version.mbtx from moon.mod. DO NOT EDIT.\n\n///|\nconst VERSION : String = \"\{value}\"\n",
  )
}
